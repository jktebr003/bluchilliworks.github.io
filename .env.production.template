# Production Environment Configuration Template
# Copy this to .env and fill in your production values
# NEVER commit .env to git!

# =============================================================================
# MongoDB Configuration
# =============================================================================
# IMPORTANT: Change this password before deploying to production!
MONGO_ROOT_PASSWORD=ChangeThisInProduction123!

# =============================================================================
# API Security
# =============================================================================
# Generate new UUIDs for production: https://www.uuidgenerator.net/
# Or use PowerShell: [guid]::NewGuid()
API_KEY=CHANGE-THIS-UUID-IN-PRODUCTION
API_KEY_SECONDARY=CHANGE-THIS-UUID-IN-PRODUCTION-TOO

# =============================================================================
# Email Configuration
# =============================================================================
EMAIL_FROM=noreply@yourdomain.com

# SMTP Settings - Update with your email provider details
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# =============================================================================
# Optional: Override Default Settings
# =============================================================================
# Uncomment and modify as needed

# Application URL
# APP_BASE_URL=https://yourdomain.com

# MongoDB Database Name (default: ttl)
# MONGO_DATABASE=your_database_name

# =============================================================================
# Production Deployment Checklist
# =============================================================================
# Before deploying to production:
# 
# [ ] Changed MONGO_ROOT_PASSWORD to a strong password
# [ ] Generated new UUIDs for API_KEY and API_KEY_SECONDARY
# [ ] Configured SMTP settings with valid credentials
# [ ] Updated EMAIL_FROM with your domain
# [ ] Tested email sending functionality
# [ ] Configured HTTPS/TLS certificates
# [ ] Set up backup strategy for MongoDB
# [ ] Configured monitoring and alerting
# [ ] Reviewed and applied security best practices
# [ ] Tested health check endpoints
# [ ] Configured log retention policies
#
# =============================================================================
