@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h5" Class="ml-3">The Teachers' Lounge</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggle" />
        <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End" />
    </MudAppBar>
    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pt-16 pa-4">
        @Body
    </MudMainContent>
</MudLayout>

<style>
    .mud-theme-light .mud-navmenu .mud-nav-link.active {
        background-color: #e8edec;
        color: #0b3c49;
        border-radius: 6px;
    }
</style>


<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private MudTheme? _theme = null;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
        };
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Primary = "#1B9AAA",
        Secondary = "#06D6A0",
        Surface = "#F8FFE5",
        Background = "#F8FFE5",
        BackgroundGray = "#F8FFE5",
        AppbarText = "#F8FFE5",
        AppbarBackground = "rgba(27,154,170,0.92)",
        DrawerBackground = "#F8FFE5",
        ActionDefault = "#1B9AAA",
        ActionDisabled = "#1B9AAA4D",
        ActionDisabledBackground = "#1B9AAA1A",
        TextPrimary = "#1B9AAA",
        TextSecondary = "#06D6A0",
        TextDisabled = "#1B9AAA66",
        DrawerIcon = "#1B9AAA",
        DrawerText = "#1B9AAA",
        GrayLight = "#06D6A0",
        GrayLighter = "#F8FFE5",
        Info = "#1B9AAA",
        Success = "#06D6A0",
        Warning = "#FFC43D",
        Error = "#EF476F",
        LinesDefault = "#FFC43D",
        TableLines = "#FFC43D",
        Divider = "#FFC43D",
        OverlayLight = "#1B9AAA26",
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#FFC43D",
        Secondary = "#06D6A0",
        Surface = "#1B9AAA",
        Background = "#1B9AAA",
        BackgroundGray = "#1B9AAA",
        AppbarText = "#F8FFE5",
        AppbarBackground = "rgba(27,154,170,0.95)",
        DrawerBackground = "#1B9AAA",
        ActionDefault = "#FFC43D",
        ActionDisabled = "#F8FFE54D",
        ActionDisabledBackground = "#F8FFE51A",
        TextPrimary = "#F8FFE5",
        TextSecondary = "#06D6A0",
        TextDisabled = "#F8FFE566",
        DrawerIcon = "#F8FFE5",
        DrawerText = "#F8FFE5",
        GrayLight = "#EF476F",
        GrayLighter = "#1B9AAA",
        Info = "#F8FFE5",
        Success = "#06D6A0",
        Warning = "#FFC43D",
        Error = "#EF476F",
        LinesDefault = "#EF476F",
        TableLines = "#EF476F",
        Divider = "#EF476F",
        OverlayLight = "#F8FFE51A",
    };

    public string DarkLightModeButtonIcon => _isDarkMode switch
    {
        true => Icons.Material.Rounded.AutoMode,
        false => Icons.Material.Outlined.DarkMode,
    };
}


