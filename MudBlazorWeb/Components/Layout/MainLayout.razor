@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazorWeb.Features.Authentication.UI
@using MudBlazorWeb.Shared.Components
@using MudBlazorWeb.Shared.Models
@inject IAuthenticationService AuthenticationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

@if (_isAuthenticated)
{
    <SessionActivityTracker />
}

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h5" Class="ml-3">The Teachers' Lounge</MudText>
        <MudSpacer />
        <MudMenu Icon="@Icons.Material.Filled.Palette" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            @foreach (var option in _themeOptions)
            {
                <MudMenuItem OnClick="@(() => ApplyTheme(option))">
                    <div class="d-flex align-center gap-2">
                        <div style="width:14px;height:14px;border-radius:50%;background:@option.PreviewColor;border:1px solid rgba(0,0,0,0.2)"></div>
                        @option.Name
                        @if (_selectedThemeName == option.Name)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="ml-1" />
                        }
                    </div>
                </MudMenuItem>
            }
        </MudMenu>
        <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggle" />
        @if (_isAuthenticated)
        {
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <ActivatorContent>
                    <MudAvatar Color="Color.Secondary" Size="Size.Small" Style="cursor:pointer;margin:0 4px">@_userInitials</MudAvatar>
                </ActivatorContent>
                <ChildContent>
                    <div class="px-4 py-2">
                        <MudText Typo="Typo.subtitle2">@_userFullName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@_userEmail</MudText>
                    </div>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Person" Href="profile">My Profile</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="OnLogoutAsync">Logout</MudMenuItem>
                </ChildContent>
            </MudMenu>
        }
        else
        {
            <MudIconButton Icon="@Icons.Material.Filled.Login" Color="Color.Inherit" Edge="Edge.End" Href="authentication/login" />
        }
    </MudAppBar>
    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pt-16 app-main-content">
        <div class="app-page-content">
            @Body
        </div>
        <SiteFooter />
    </MudMainContent>
    <MudScrollToTop>
        <MudFab Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.ArrowUpward" />
    </MudScrollToTop>
</MudLayout>

<style>
    .app-main-content {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .app-page-content {
        flex: 1 0 auto;
        padding: 1rem;
    }

    .mud-navmenu .mud-nav-link.active {
        background-color: @_activeNavBackground;
        color: @_activeNavText;
        border-radius: 6px;
    }
</style>


<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private MudTheme? _theme = null;
    private string _selectedThemeName = "Ocean Mist";
    private ThemeOption? _activeTheme;
    private string _activeNavBackground = "#e8edec";
    private string _activeNavText = "#0b3c49";
    private ThemeOption[] _themeOptions = [];

    private bool _isAuthenticated;
    private string _userInitials = string.Empty;
    private string _userFullName = string.Empty;
    private string _userEmail = string.Empty;

    private record ThemeOption(string Name, string PreviewColor, PaletteLight Light, PaletteDark Dark);

    protected override async Task OnInitializedAsync()
    {
        await RefreshUserStateAsync();
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
    }

    private async void OnAuthStateChanged(Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState> task)
    {
        await RefreshUserStateAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshUserStateAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = state.User.Identity?.IsAuthenticated == true;
        if (_isAuthenticated)
        {
            var user = await AuthenticationService.GetCurrentUserAsync();
            _userFullName = $"{user?.FirstName} {user?.LastName}".Trim();
            _userEmail = user?.EmailAddress ?? string.Empty;
            var first = user?.FirstName?.Length > 0 ? user.FirstName[0].ToString() : string.Empty;
            var last = user?.LastName?.Length > 0 ? user.LastName[0].ToString() : string.Empty;
            _userInitials = $"{first}{last}".ToUpper();
        }
        else
        {
            _userFullName = string.Empty;
            _userEmail = string.Empty;
            _userInitials = string.Empty;
        }
    }

    private async Task OnLogoutAsync()
    {
        await AuthenticationService.LogoutAsync();
        await RefreshUserStateAsync();
        NavigationManager.NavigateTo("/authentication/login", forceLoad: true);
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _themeOptions =
        [
            new ThemeOption("Teal",    "#1B9AAA", TealLight,    TealDark),
            new ThemeOption("Crimson", "#C1121F", CrimsonLight, CrimsonDark),
            new ThemeOption("Indigo",  "#3A0CA3", IndigoLight,  IndigoDark),
            new ThemeOption("Forest",  "#386641", ForestLight,  ForestDark),
            new ThemeOption("Cedar Gold", "#99582A", CedarGoldLight, CedarGoldDark),
            new ThemeOption("Ocean Mist", "#0077B6", OceanMistLight, OceanMistDark),
            @* new ThemeOption("Formula 1", "#0d3d8e", Formula1Light, Formula1Dark), *@
        ];

        var defaultTheme = _themeOptions[0];
        foreach (var option in _themeOptions)
        {
            if (option.Name == "Ocean Mist")
            {
                defaultTheme = option;
                break;
            }
        }

        ApplyTheme(defaultTheme);
    }

    private void ApplyTheme(ThemeOption option)
    {
        _activeTheme = option;
        _selectedThemeName = option.Name;
        _theme = new MudTheme
        {
            PaletteLight = option.Light,
            PaletteDark = option.Dark,
            LayoutProperties = new LayoutProperties()
        };

        UpdateActiveNavColors();
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
        UpdateActiveNavColors();
    }

    private void UpdateActiveNavColors()
    {
        if (_activeTheme is null)
            return;

        if (_isDarkMode)
        {
            var darkBase = _activeTheme.Dark.Tertiary ?? _activeTheme.Dark.Secondary ?? _activeTheme.Dark.Primary ?? new MudBlazor.Utilities.MudColor("#0d3d8e");
            _activeNavBackground = ToRgba(darkBase, "0.20");
            _activeNavText = "#FFFFFF";
            return;
        }

        var lightBase = _activeTheme.Light.Tertiary ?? _activeTheme.Light.Secondary ?? _activeTheme.Light.Primary ?? new MudBlazor.Utilities.MudColor("#0d3d8e");
        _activeNavBackground = ToRgba(lightBase, "0.10");
        _activeNavText = ToHex(_activeTheme.Light.Primary ?? new MudBlazor.Utilities.MudColor("#0b3c49"));
    }

    private static string ToRgba(MudBlazor.Utilities.MudColor color, string alpha)
    {
        return $"rgba({color.R},{color.G},{color.B},{alpha})";
    }

    private static string ToHex(MudBlazor.Utilities.MudColor color)
    {
        return $"#{color.R:X2}{color.G:X2}{color.B:X2}";
    }

    public string DarkLightModeButtonIcon => _isDarkMode switch
    {
        true => Icons.Material.Rounded.AutoMode,
        false => Icons.Material.Outlined.DarkMode,
    };

