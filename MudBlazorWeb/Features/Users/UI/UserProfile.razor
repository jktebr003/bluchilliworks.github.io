@page "/profile"

@using MudBlazor
@using Fluxor
@using Fluxor.Blazor.Web.Components
@using MudBlazorWeb.Features.Authentication
@using MudBlazorWeb.Shared.Enums
@using MudBlazorWeb.Shared.Models
@using static MudBlazorWeb.Features.Users.UI.UsersActions
@implements IDisposable

@inject IState<UsersState> UsersState
@inject IAuthenticationService AuthService
@inject IDispatcher Dispatcher
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

@inherits FluxorComponent

<div class="div-page-content">
    <span class="heading-meta">Profile</span>
    <MudText Typo="Typo.h4" GutterBottom="true" class="ttl-heading">My Profile</MudText>

    @if (showSuccessAlert)
    {
        <MudAlert Severity="MudBlazor.Severity.Success"
                  Class="mb-4" 
                  ShowCloseIcon="true"
                  CloseIcon="@Icons.Material.Filled.Close" 
                  CloseIconClicked="@(() => showSuccessAlert = false)">
            Profile updated successfully!
        </MudAlert>
    }

    @if (showErrorAlert && !string.IsNullOrEmpty(UsersState.Value.ErrorMessage))
    {
        <MudAlert Severity="MudBlazor.Severity.Error" 
                  Class="mb-4"
                  ShowCloseIcon="true"
                  CloseIcon="@Icons.Material.Filled.Close" 
                  CloseIconClicked="@(() => showErrorAlert = false)">
            @UsersState.Value.ErrorMessage
        </MudAlert>
    }

    <!-- Header Section with Edit/Save/Cancel Buttons -->
    <div class="d-flex justify-space-between align-center mb-4">
        <MudSpacer />
        <div>
            @if (!isEditMode)
            {
                <MudButton Variant="Variant.Filled" 
                          Color="Color.Primary" 
                          StartIcon="@Icons.Material.Filled.Edit"
                          OnClick="@EnableEditMode">
                    Edit Profile
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Text" 
                          Color="Color.Default" 
                          OnClick="@CancelEdit"
                          Class="mr-2">
                    Cancel
                </MudButton>
                <MudButton Variant="Variant.Filled" 
                          Color="Color.Primary" 
                          StartIcon="@Icons.Material.Filled.Save"
                          OnClick="@SaveProfile"
                          Disabled="@(!isFormValid || UsersState.Value.IsLoadingProfile)">
                    @(UsersState.Value.IsLoadingProfile ? "Saving..." : "Save Changes")
                </MudButton>
            }
        </div>
    </div>

    @if (UsersState.Value.IsLoadingProfile)
    {
        <div class="text-center py-5">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Class="mt-3">Loading profile...</MudText>
        </div>
    }
    else if (currentUser == null)
    {
        <MudAlert Severity="MudBlazor.Severity.Warning">
            Please log in to view your profile.
        </MudAlert>
    }
    else
    {
        <MudForm @ref="form" @bind-IsValid="@isFormValid">
            <MudGrid>
                <!-- Personal Details Section -->
                <MudItem xs="12">
                    <MudPaper Class="pa-4 mb-4" Elevation="2">
                        <MudText Typo="Typo.h6" Class="mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2" />
                            Personal Details
                        </MudText>
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                @if (isEditMode)
                                {
                                    <MudTextField @bind-Value="currentUser.FirstName"
                                                Label="First Name"
                                                Variant="Variant.Outlined"
                                                Required="true"
                                                RequiredError="First name is required" />
                                }
                                else
                                {
                                    <div class="detail-field">
                                        <MudText Typo="Typo.subtitle2" Class="field-label">First Name</MudText>
                                        <MudText Typo="Typo.body1">@currentUser.FirstName</MudText>
                                    </div>
                                }
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                @if (isEditMode)
                                {
                                    <MudTextField @bind-Value="currentUser.LastName"
                                                Label="Last Name"
                                                Variant="Variant.Outlined"
                                                Required="true"
                                                RequiredError="Last name is required" />
                                }
                                else
                                {
                                    <div class="detail-field">
                                        <MudText Typo="Typo.subtitle2" Class="field-label">Last Name</MudText>
                                        <MudText Typo="Typo.body1">@currentUser.LastName</MudText>
                                    </div>
                                }
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                @if (isEditMode)
                                {
                                    <MudTextField @bind-Value="currentUser.EmailAddress"
                                                Label="Email Address"
                                                Variant="Variant.Outlined"
                                                InputType="InputType.Email"
                                                Required="true"
                                                RequiredError="Email is required" />
                                }
                                else
                                {
                                    <div class="detail-field">
                                        <MudText Typo="Typo.subtitle2" Class="field-label">Email Address</MudText>
                                        <MudText Typo="Typo.body1">@currentUser.EmailAddress</MudText>
                                    </div>
                                }
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                @if (isEditMode)
                                {
                                    <MudSelect @bind-Value="currentUser.Gender"
                                             Label="Gender"
                                             Variant="Variant.Outlined"
                                             AnchorOrigin="Origin.BottomCenter">
                                        <MudSelectItem Value="@("Male")">Male</MudSelectItem>
                                        <MudSelectItem Value="@("Female")">Female</MudSelectItem>
                                        <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                                        <MudSelectItem Value="@("Prefer not to say")">Prefer not to say</MudSelectItem>
                                    </MudSelect>
                                }
                                else
                                {
                                    <div class="detail-field">
                                        <MudText Typo="Typo.subtitle2" Class="field-label">Gender</MudText>
                                        <MudText Typo="Typo.body1">@(currentUser.Gender ?? "Not specified")</MudText>
                                    </div>
                                }
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                @if (isEditMode)
                                {
                                    <MudDatePicker @bind-Date="dateOfBirth"
                                                 Label="Date of Birth"
                                                 Variant="Variant.Outlined"
                                                 Editable="true"
                                                 MaxDate="DateTime.Today" />
                                }
                                else
                                {
                                    <div class="detail-field">
                                        <MudText Typo="Typo.subtitle2" Class="field-label">Date of Birth</MudText>
                                        <MudText Typo="Typo.body1">@(dateOfBirth?.ToString("MMMM dd, yyyy") ?? "Not specified")</MudText>
                                    </div>
                                }
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                @if (isEditMode)
                                {
                                    <MudTextField @bind-Value="currentUser.TelephoneNumber"
                                                Label="Telephone Number"
                                                Variant="Variant.Outlined" />
                                }
                                else
                                {
                                    <div class="detail-field">
                                        <MudText Typo="Typo.subtitle2" Class="field-label">Telephone Number</MudText>
                                        <MudText Typo="Typo.body1">@(currentUser.TelephoneNumber ?? "Not specified")</MudText>
                                    </div>
                                }
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                @if (isEditMode)
                                {
                                    <MudTextField @bind-Value="currentUser.MobileNumber"
                                                Label="Mobile Number"
                                                Variant="Variant.Outlined" />
                                }
                                else
                                {
                                    <div class="detail-field">
                                        <MudText Typo="Typo.subtitle2" Class="field-label">Mobile Number</MudText>
                                        <MudText Typo="Typo.body1">@(currentUser.MobileNumber ?? "Not specified")</MudText>
                                    </div>
                                }
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>

                <!-- Package Section -->
                <MudItem xs="12">
                    <MudPaper Class="pa-4 mb-4" Elevation="2">
                        <MudText Typo="Typo.h6" Class="mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.CardMembership" Class="mr-2" />
                            Package
                        </MudText>
                        @if (currentUser.Package != null)
                        {
                            <MudCard Outlined="true">
                                <MudCardContent>
                                    <MudText Typo="Typo.h6">@currentUser.Package.Name</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@currentUser.Package.Description</MudText>
                                    <MudText Typo="Typo.body1" Class="mt-2">
                                        <strong>Price:</strong> @currentUser.Package.Price
                                    </MudText>
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="mt-2">
                                        @* @currentUser.Package.Type.ToString() *@
                                        @GetPackageTypeDisplayName(currentUser.Package.Type)
                                    </MudChip>
                                </MudCardContent>
                            </MudCard>
                        }
                        else
                        {
                            <MudAlert Severity="MudBlazor.Severity.Info">
                                No package selected. Visit our pricing page to choose a package.
                            </MudAlert>
                        }
                    </MudPaper>
                </MudItem>

                <!-- Work Experience Section -->
                <MudItem xs="12">
                    <MudPaper Class="pa-4 mb-4" Elevation="2">
                        <div class="d-flex justify-space-between align-center mb-4">
                            <MudText Typo="Typo.h6">
                                <MudIcon Icon="@Icons.Material.Filled.Work" Class="mr-2" />
                                Work Experience
                            </MudText>
                            @if (isEditMode)
                            {
                                <MudButton Variant="Variant.Filled"
                                         Color="Color.Primary"
                                         Size="Size.Small"
                                         OnClick="AddJob"
                                         StartIcon="@Icons.Material.Filled.Add">
                                    Add Job
                                </MudButton>
                            }
                        </div>
                        @if (jobs.Any())
                        {
                            @foreach (var (job, index) in jobs.Select((j, i) => (j, i)))
                            {
                                <MudCard Class="mb-3" Outlined="true">
                                    <MudCardContent>
                                        <div class="d-flex justify-space-between align-center mb-3">
                                            <MudText Typo="Typo.subtitle1" Color="Color.Primary">Job @(index + 1)</MudText>
                                            @if (isEditMode)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                             Color="Color.Error"
                                                             Size="Size.Small"
                                                             OnClick="@(() => RemoveJob(job))" />
                                            }
                                        </div>
                                        <MudGrid>
                                            <MudItem xs="12" sm="6">
                                                @if (isEditMode)
                                                {
                                                    <MudTextField @bind-Value="job.Company"
                                                                Label="Company"
                                                                Variant="Variant.Outlined"
                                                                Margin="Margin.Dense" />
                                                }
                                                else
                                                {
                                                    <div class="detail-field">
                                                        <MudText Typo="Typo.subtitle2" Class="field-label">Company</MudText>
                                                        <MudText Typo="Typo.body2">@(job.Company ?? "Not specified")</MudText>
                                                    </div>
                                                }
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                @if (isEditMode)
                                                {
                                                    <MudTextField @bind-Value="job.Position"
                                                                Label="Position"
                                                                Variant="Variant.Outlined"
                                                                Margin="Margin.Dense" />
                                                }
                                                else
                                                {
                                                    <div class="detail-field">
                                                        <MudText Typo="Typo.subtitle2" Class="field-label">Position</MudText>
                                                        <MudText Typo="Typo.body2">@(job.Position ?? "Not specified")</MudText>
                                                    </div>
                                                }
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                @if (isEditMode)
                                                {
                                                    <MudDatePicker Date="@GetJobStartDate(job)"
                                                                 DateChanged="@((DateTime? date) => SetJobStartDate(job, date))"
                                                                 Label="Start Date"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Editable="true" />
                                                }
                                                else
                                                {
                                                    <div class="detail-field">
                                                        <MudText Typo="Typo.subtitle2" Class="field-label">Start Date</MudText>
                                                        <MudText Typo="Typo.body2">@(GetJobStartDate(job)?.ToString("MMMM yyyy") ?? "Not specified")</MudText>
                                                    </div>
                                                }
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                @if (isEditMode)
                                                {
                                                    <MudDatePicker Date="@GetJobEndDate(job)"
                                                                 DateChanged="@((DateTime? date) => SetJobEndDate(job, date))"
                                                                 Label="End Date"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Editable="true"
                                                                 Clearable="true" />
                                                }
                                                else
                                                {
                                                    <div class="detail-field">
                                                        <MudText Typo="Typo.subtitle2" Class="field-label">End Date</MudText>
                                                        <MudText Typo="Typo.body2">@(GetJobEndDate(job)?.ToString("MMMM yyyy") ?? "Present")</MudText>
                                                    </div>
                                                }
                                            </MudItem>
                                            <MudItem xs="12">
                                                @if (isEditMode)
                                                {
                                                    <MudTextField @bind-Value="job.Responsibilities"
                                                                Label="Responsibilities"
                                                                Variant="Variant.Outlined"
                                                                Lines="3"
                                                                Margin="Margin.Dense" />
                                                }
                                                else
                                                {
                                                    <div class="detail-field">
                                                        <MudText Typo="Typo.subtitle2" Class="field-label">Responsibilities</MudText>
                                                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@(job.Responsibilities ?? "Not specified")</MudText>
                                                    </div>
                                                }
                                            </MudItem>
                                        </MudGrid>
                                    </MudCardContent>
                                </MudCard>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No work experience added yet.</MudText>
                        }
                    </MudPaper>
                </MudItem>

                <!-- Education Section -->
                <MudItem xs="12">
                    <MudPaper Class="pa-4 mb-4" Elevation="2">
                        <div class="d-flex justify-space-between align-center mb-4">
                            <MudText Typo="Typo.h6">
                                <MudIcon Icon="@Icons.Material.Filled.School" Class="mr-2" />
                                Education (Qualifications)
                            </MudText>
                            @if (isEditMode)
                            {
                                <MudButton Variant="Variant.Filled"
                                         Color="Color.Primary"
                                         Size="Size.Small"
                                         OnClick="AddQualification"
                                         StartIcon="@Icons.Material.Filled.Add">
                                    Add Qualification
                                </MudButton>
                            }
                        </div>
                        @if (qualifications.Any())
                        {
                            @foreach (var (qual, index) in qualifications.Select((q, i) => (q, i)))
                            {
                                <MudCard Class="mb-3" Outlined="true">
                                    <MudCardContent>
                                        <div class="d-flex justify-space-between align-center mb-3">
                                            <MudText Typo="Typo.subtitle1" Color="Color.Primary">Qualification @(index + 1)</MudText>
                                            @if (isEditMode)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                             Color="Color.Error"
                                                             Size="Size.Small"
                                                             OnClick="@(() => RemoveQualification(qual))" />
                                            }
                                        </div>
                                        <MudGrid>
                                            <MudItem xs="12" sm="6">
                                                @if (isEditMode)
                                                {
                                                    <MudTextField @bind-Value="qual.Institution"
                                                                Label="Institution"
                                                                Variant="Variant.Outlined"
                                                                Margin="Margin.Dense" />
                                                }
                                                else
                                                {
                                                    <div class="detail-field">
                                                        <MudText Typo="Typo.subtitle2" Class="field-label">Institution</MudText>
                                                        <MudText Typo="Typo.body2">@(qual.Institution ?? "Not specified")</MudText>
                                                    </div>
                                                }
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                @if (isEditMode)
                                                {
                                                    <MudTextField @bind-Value="qual.Title"
                                                                Label="Title"
                                                                Variant="Variant.Outlined"
                                                                Margin="Margin.Dense" />
                                                }
                                                else
                                                {
                                                    <div class="detail-field">
                                                        <MudText Typo="Typo.subtitle2" Class="field-label">Title</MudText>
                                                        <MudText Typo="Typo.body2">@(qual.Title ?? "Not specified")</MudText>
                                                    </div>
                                                }
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                @if (isEditMode)
                                                {
                                                    <MudNumericField @bind-Value="qual.Year"
                                                                   Label="Year"
                                                                   Variant="Variant.Outlined"
                                                                   Margin="Margin.Dense"
                                                                   Min="1900"
                                                                   Max="@DateTime.Now.Year" />
                                                }
                                                else
                                                {
                                                    <div class="detail-field">
                                                        <MudText Typo="Typo.subtitle2" Class="field-label">Year</MudText>
                                                        <MudText Typo="Typo.body2">@(qual.Year?.ToString() ?? "Not specified")</MudText>
                                                    </div>
                                                }
                                            </MudItem>
                                        </MudGrid>
                                    </MudCardContent>
                                </MudCard>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No qualifications added yet.</MudText>
                        }
                    </MudPaper>
                </MudItem>

                <!-- Certifications Section -->
                <MudItem xs="12">
                    <MudPaper Class="pa-4 mb-4" Elevation="2">
                        <div class="d-flex justify-space-between align-center mb-4">
                            <MudText Typo="Typo.h6">
                                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="mr-2" />
                                Certifications
                            </MudText>
                            @if (isEditMode)
                            {
                                <MudButton Variant="Variant.Filled"
                                         Color="Color.Primary"
                                         Size="Size.Small"
                                         OnClick="AddCertification"
                                         StartIcon="@Icons.Material.Filled.Add">
                                    Add Certification
                                </MudButton>
                            }
                        </div>
                        @if (certifications.Any())
                        {
                            @foreach (var (cert, index) in certifications.Select((c, i) => (c, i)))
                            {
                                <MudCard Class="mb-3" Outlined="true">
                                    <MudCardContent>
                                        <div class="d-flex justify-space-between align-center mb-3">
                                            <MudText Typo="Typo.subtitle1" Color="Color.Primary">Certification @(index + 1)</MudText>
                                            @if (isEditMode)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                             Color="Color.Error"
                                                             Size="Size.Small"
                                                             OnClick="@(() => RemoveCertification(cert))" />
                                            }
                                        </div>
                                        <MudGrid>
                                            <MudItem xs="12" sm="6">
                                                @if (isEditMode)
                                                {
                                                    <MudTextField @bind-Value="cert.Institution"
                                                                Label="Institution"
                                                                Variant="Variant.Outlined"
                                                                Margin="Margin.Dense" />
                                                }
                                                else
                                                {
                                                    <div class="detail-field">
                                                        <MudText Typo="Typo.subtitle2" Class="field-label">Institution</MudText>
                                                        <MudText Typo="Typo.body2">@(cert.Institution ?? "Not specified")</MudText>
                                                    </div>
                                                }
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                @if (isEditMode)
                                                {
                                                    <MudTextField @bind-Value="cert.Title"
                                                                Label="Title"
                                                                Variant="Variant.Outlined"
                                                                Margin="Margin.Dense" />
                                                }
                                                else
                                                {
                                                    <div class="detail-field">
                                                        <MudText Typo="Typo.subtitle2" Class="field-label">Title</MudText>
                                                        <MudText Typo="Typo.body2">@(cert.Title ?? "Not specified")</MudText>
                                                    </div>
                                                }
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                @if (isEditMode)
                                                {
                                                    <MudNumericField @bind-Value="cert.Year"
                                                                   Label="Year"
                                                                   Variant="Variant.Outlined"
                                                                   Margin="Margin.Dense"
                                                                   Min="1900"
                                                                   Max="@DateTime.Now.Year" />
                                                }
                                                else
                                                {
                                                    <div class="detail-field">
                                                        <MudText Typo="Typo.subtitle2" Class="field-label">Year</MudText>
                                                        <MudText Typo="Typo.body2">@(cert.Year?.ToString() ?? "Not specified")</MudText>
                                                    </div>
                                                }
                                            </MudItem>
                                        </MudGrid>
                                    </MudCardContent>
                                </MudCard>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No certifications added yet.</MudText>
                        }
                    </MudPaper>
                </MudItem>

                <!-- Skills & Abilities Section -->
                <MudItem xs="12">
                    <MudPaper Class="pa-4 mb-4" Elevation="2">
                        <MudText Typo="Typo.h6" Class="mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.Stars" Class="mr-2" />
                            Skills & Abilities
                        </MudText>
                        @if (isEditMode)
                        {
                            <MudTextField @bind-Value="skillsText"
                                        Label="Skills & Abilities"
                                        Variant="Variant.Outlined"
                                        Lines="6"
                                        Placeholder="Enter your skills and abilities (e.g., Programming, Project Management, Communication, etc.)" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                                Enter skills separated by commas or line breaks
                            </MudText>
                        }
                        else
                        {
                            <div class="detail-field">
                                <MudPaper Class="pa-3 content-display" Elevation="0">
                                    <MudText Typo="Typo.body1" Style="white-space: pre-wrap;">@(skillsText ?? "No skills specified")</MudText>
                                </MudPaper>
                            </div>
                        }
                    </MudPaper>
                </MudItem>

                <!-- Hobbies & Interests Section -->
                <MudItem xs="12">
                    <MudPaper Class="pa-4 mb-4" Elevation="2">
                        <MudText Typo="Typo.h6" Class="mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.FavoriteBorder" Class="mr-2" />
                            Hobbies & Interests
                        </MudText>
                        @if (isEditMode)
                        {
                            <MudTextField @bind-Value="hobbiesText"
                                        Label="Hobbies & Interests"
                                        Variant="Variant.Outlined"
                                        Lines="6"
                                        Placeholder="Enter your hobbies and interests (e.g., Reading, Hiking, Photography, Gaming, etc.)" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                                Enter hobbies separated by commas or line breaks
                            </MudText>
                        }
                        else
                        {
                            <div class="detail-field">
                                <MudPaper Class="pa-3 content-display" Elevation="0">
                                    <MudText Typo="Typo.body1" Style="white-space: pre-wrap;">@(hobbiesText ?? "No hobbies specified")</MudText>
                                </MudPaper>
                            </div>
                        }
                    </MudPaper>
                </MudItem>

            </MudGrid>
        </MudForm>
    }
</div>

@code {
    private MudForm form = null!;
    private bool isFormValid;
    private bool isEditMode = false;
    private UserResponse? currentUser;
    private UserResponse? originalUser;
    private DateTime? dateOfBirth;
    private DateTime? originalDateOfBirth;
    private string? skillsText;
    private string? originalSkillsText;
    private string? hobbiesText;
    private string? originalHobbiesText;

    private List<JobResponse> jobs = new();
    private List<QualificationResponse> qualifications = new();
    private List<CertificationResponse> certifications = new();
    private Dictionary<JobResponse, DateTime?> jobStartDates = new();
    private Dictionary<JobResponse, DateTime?> jobEndDates = new();
    
    private List<JobResponse> originalJobs = new();
    private List<QualificationResponse> originalQualifications = new();
    private List<CertificationResponse> originalCertifications = new();
    private Dictionary<JobResponse, DateTime?> originalJobStartDates = new();
    private Dictionary<JobResponse, DateTime?> originalJobEndDates = new();
    
    private bool showSuccessAlert = false;
    private bool showErrorAlert = false;
    private bool wasLoading = false;
    private bool isUpdateOperation = false;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        // Subscribe to state changes
        UsersState.StateChanged += OnStateChanged;

        // Get current user from authentication service
        var authenticatedUser = await AuthService.GetCurrentUserAsync();
        if (authenticatedUser != null)
        {
            currentUser = new UserResponse
            {
                ID = authenticatedUser.ID,
                FirstName = authenticatedUser.FirstName,
                LastName = authenticatedUser.LastName,
                EmailAddress = authenticatedUser.EmailAddress,
                Gender = authenticatedUser.Gender,
                DateOfBirth = authenticatedUser.DateOfBirth,
                TelephoneNumber = authenticatedUser.TelephoneNumber,
                MobileNumber = authenticatedUser.MobileNumber,
                Package = authenticatedUser.Package,
                Username = authenticatedUser.Username,
                UserRole = authenticatedUser.UserRole,
                Skills = authenticatedUser.Skills,
                Hobbies = authenticatedUser.Hobbies,
                @* DecryptedPassword = authenticatedUser.DecryptedPassword,
                EncryptedPassword = authenticatedUser.EncryptedPassword *@
            };

            // Parse date of birth
            if (!string.IsNullOrEmpty(currentUser.DateOfBirth) &&
                DateTime.TryParse(currentUser.DateOfBirth, out var dob))
            {
                dateOfBirth = dob;
            }

            // Load Skills and Hobbies
            skillsText = currentUser.Skills;
            hobbiesText = currentUser.Hobbies;

            // Load existing data
            jobs = authenticatedUser.Jobs?.ToList() ?? new List<JobResponse>();
            qualifications = authenticatedUser.Qualifications?.ToList() ?? new List<QualificationResponse>();
            certifications = authenticatedUser.Certifications?.ToList() ?? new List<CertificationResponse>();

            // Initialize job date dictionaries
            foreach (var job in jobs)
            {
                if (!string.IsNullOrEmpty(job.StartDate) && DateTime.TryParse(job.StartDate, out var startDate))
                    jobStartDates[job] = startDate;
                if (!string.IsNullOrEmpty(job.EndDate) && DateTime.TryParse(job.EndDate, out var endDate))
                    jobEndDates[job] = endDate;
            }

            // Load profile data if needed
            if (!string.IsNullOrEmpty(currentUser.ID))
            {
                Dispatcher.Dispatch(new LoadUserProfileAction(currentUser.ID));
            }
        }
    }

    private void EnableEditMode()
    {
        isEditMode = true;
        isUpdateOperation = false;
        
        // Create deep copies of current state
        if (currentUser != null)
        {
            originalUser = new UserResponse
            {
                ID = currentUser.ID,
                FirstName = currentUser.FirstName,
                LastName = currentUser.LastName,
                EmailAddress = currentUser.EmailAddress,
                Gender = currentUser.Gender,
                DateOfBirth = currentUser.DateOfBirth,
                TelephoneNumber = currentUser.TelephoneNumber,
                MobileNumber = currentUser.MobileNumber,
                Package = currentUser.Package,
                Username = currentUser.Username,
                UserRole = currentUser.UserRole
            };
        }
        
        originalDateOfBirth = dateOfBirth;
        originalSkillsText = skillsText;
        originalHobbiesText = hobbiesText;
        originalJobs = jobs.Select(j => new JobResponse
        {
            ID = j.ID,
            Company = j.Company,
            Position = j.Position,
            StartDate = j.StartDate,
            EndDate = j.EndDate,
            Responsibilities = j.Responsibilities
        }).ToList();
        originalQualifications = qualifications.Select(q => new QualificationResponse
        {
            ID = q.ID,
            Institution = q.Institution,
            Title = q.Title,
            Year = q.Year
        }).ToList();
        originalCertifications = certifications.Select(c => new CertificationResponse
        {
            ID = c.ID,
            Institution = c.Institution,
            Title = c.Title,
            Year = c.Year
        }).ToList();
        originalJobStartDates = new Dictionary<JobResponse, DateTime?>(jobStartDates);
        originalJobEndDates = new Dictionary<JobResponse, DateTime?>(jobEndDates);
    }

    private void CancelEdit()
    {
        isEditMode = false;
        isUpdateOperation = false;
        
        // Restore original values
        if (originalUser != null && currentUser != null)
        {
            currentUser.FirstName = originalUser.FirstName;
            currentUser.LastName = originalUser.LastName;
            currentUser.EmailAddress = originalUser.EmailAddress;
            currentUser.Gender = originalUser.Gender;
            currentUser.DateOfBirth = originalUser.DateOfBirth;
            currentUser.TelephoneNumber = originalUser.TelephoneNumber;
            currentUser.MobileNumber = originalUser.MobileNumber;
        }
        
        dateOfBirth = originalDateOfBirth;
        skillsText = originalSkillsText;
        hobbiesText = originalHobbiesText;
        jobs = originalJobs.Select(j => new JobResponse
        {
            ID = j.ID,
            Company = j.Company,
            Position = j.Position,
            StartDate = j.StartDate,
            EndDate = j.EndDate,
            Responsibilities = j.Responsibilities
        }).ToList();
        qualifications = originalQualifications.Select(q => new QualificationResponse
        {
            ID = q.ID,
            Institution = q.Institution,
            Title = q.Title,
            Year = q.Year
        }).ToList();
        certifications = originalCertifications.Select(c => new CertificationResponse
        {
            ID = c.ID,
            Institution = c.Institution,
            Title = c.Title,
            Year = c.Year
        }).ToList();
        jobStartDates = new Dictionary<JobResponse, DateTime?>(originalJobStartDates);
        jobEndDates = new Dictionary<JobResponse, DateTime?>(originalJobEndDates);
    }

    private void AddJob()
    {
        var newJob = new JobResponse
        {
            Company = string.Empty,
            Position = string.Empty,
            StartDate = DateTime.Now.ToString("yyyy-MM-dd"),
            EndDate = null,
            Responsibilities = string.Empty
        };
        jobs.Add(newJob);
        jobStartDates[newJob] = DateTime.Now;
        jobEndDates[newJob] = null;
    }

    private void RemoveJob(JobResponse job)
    {
        jobs.Remove(job);
        jobStartDates.Remove(job);
        jobEndDates.Remove(job);
    }

    private DateTime? GetJobStartDate(JobResponse job)
    {
        return jobStartDates.TryGetValue(job, out var date) ? date : null;
    }

    private void SetJobStartDate(JobResponse job, DateTime? date)
    {
        jobStartDates[job] = date;
        job.StartDate = date?.ToString("yyyy-MM-dd");
    }

    private DateTime? GetJobEndDate(JobResponse job)
    {
        return jobEndDates.TryGetValue(job, out var date) ? date : null;
    }

    private void SetJobEndDate(JobResponse job, DateTime? date)
    {
        jobEndDates[job] = date;
        job.EndDate = date?.ToString("yyyy-MM-dd");
    }

    private void AddQualification()
    {
        qualifications.Add(new QualificationResponse
        {
            ID = Guid.NewGuid().ToString(),
            Institution = string.Empty,
            Title = string.Empty,
            Year = DateTime.Now.Year
        });
    }

    private void RemoveQualification(QualificationResponse qual)
    {
        qualifications.Remove(qual);
    }

    private void AddCertification()
    {
        certifications.Add(new CertificationResponse
        {
            ID = Guid.NewGuid().ToString(),
            Institution = string.Empty,
            Title = string.Empty,
            Year = DateTime.Now.Year
        });
    }

    private void RemoveCertification(CertificationResponse cert)
    {
        certifications.Remove(cert);
    }

    private async Task SaveProfile()
    {
        // Hide any existing alerts when starting a new save
        showSuccessAlert = false;
        showErrorAlert = false;
        
        // Mark this as an update operation
        isUpdateOperation = true;
        
        if (form != null)
        {
            await form.Validate();

            if (!isFormValid)
            {
                Snackbar.Add("Please fill in all required fields", MudBlazor.Severity.Warning);
                return;
            }
        }

        if (currentUser == null)
        {
            Snackbar.Add("Invalid user data", MudBlazor.Severity.Error);
            return;
        }

        if (!Guid.TryParse(currentUser.ID, out var userId))
        {
            isUpdateOperation = false;
            Snackbar.Add("Unable to update profile due to an invalid user identifier.", MudBlazor.Severity.Error);
            return;
        }

        // Update date of birth
        currentUser.DateOfBirth = dateOfBirth?.ToString("yyyy-MM-dd");

        // Update job dates from dictionaries
        foreach (var job in jobs)
        {
            if (jobStartDates.ContainsKey(job))
                job.StartDate = jobStartDates[job]?.ToString("yyyy-MM-dd");
            if (jobEndDates.ContainsKey(job))
                job.EndDate = jobEndDates[job]?.ToString("yyyy-MM-dd");
        }

        var updateRequest = new UpdateUserRequest
        {
            Id = userId,
            FirstName = currentUser.FirstName,
            LastName = currentUser.LastName,
            EmailAddress = currentUser.EmailAddress,
            Gender = currentUser.Gender,
            DateOfBirth = currentUser.DateOfBirth,
            TelephoneNumber = currentUser.TelephoneNumber,
            MobileNumber = currentUser.MobileNumber,
            PackageId = currentUser.Package?.ID,
            Jobs = jobs,
            Qualifications = qualifications,
            Certifications = certifications,
            Skills = skillsText,
            Hobbies = hobbiesText,
            Username = currentUser.Username,
            UserType = currentUser.UserRole,
            @* DecryptedPassword = currentUser.DecryptedPassword,
            EncryptedPassword = currentUser.EncryptedPassword *@
        };

        Dispatcher.Dispatch(new UpdateUserProfileAction(updateRequest));
    }

    private string GetPackageTypeDisplayName(PackageType type)
    {
        return type switch
        {
            PackageType.Monthly => "Monthly",
            PackageType.TwoYearSubscription => "2-year Subscription",
            _ => "Standard"
        };
    }

    private void OnStateChanged(object? sender, EventArgs e)
    {
        // Detect when loading completes (transition from loading to not loading)
        bool justFinishedLoading = wasLoading && !UsersState.Value.IsLoadingProfile;
        
        if (justFinishedLoading)
        {
            wasLoading = false;
            
            // Update current user from state if loaded
            if (UsersState.Value.CurrentUser != null && currentUser != null)
            {
                currentUser = UsersState.Value.CurrentUser;
                
                // Update collections
                jobs = currentUser.Jobs?.ToList() ?? new List<JobResponse>();
                qualifications = currentUser.Qualifications?.ToList() ?? new List<QualificationResponse>();
                certifications = currentUser.Certifications?.ToList() ?? new List<CertificationResponse>();

                // Reinitialize job date dictionaries
                jobStartDates.Clear();
                jobEndDates.Clear();
                foreach (var job in jobs)
                {
                    if (!string.IsNullOrEmpty(job.StartDate) && DateTime.TryParse(job.StartDate, out var startDate))
                        jobStartDates[job] = startDate;
                    if (!string.IsNullOrEmpty(job.EndDate) && DateTime.TryParse(job.EndDate, out var endDate))
                        jobEndDates[job] = endDate;
                }

                // Parse date of birth
                if (!string.IsNullOrEmpty(currentUser.DateOfBirth) &&
                    DateTime.TryParse(currentUser.DateOfBirth, out var dob))
                {
                    dateOfBirth = dob;
                }

                // Update Skills and Hobbies
                skillsText = currentUser.Skills;
                hobbiesText = currentUser.Hobbies;
            }

            // Show alerts after update completes
            if (!string.IsNullOrEmpty(UsersState.Value.ErrorMessage))
            {
                showErrorAlert = true;
                showSuccessAlert = false;
            }
            else if (UsersState.Value.CurrentUser != null && isUpdateOperation)
            {
                showSuccessAlert = true;
                showErrorAlert = false;
                isEditMode = false; // Exit edit mode on successful save
            }
            
            // Reset the update operation flag
            isUpdateOperation = false;
            
            InvokeAsync(StateHasChanged);
        }
        else if (UsersState.Value.IsLoadingProfile && !wasLoading)
        {
            wasLoading = true;
        }
    }

    public void Dispose()
    {
        UsersState.StateChanged -= OnStateChanged;
    }
}

