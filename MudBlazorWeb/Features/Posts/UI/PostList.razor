@page "/posts"

@using Fluxor
@using Fluxor.Blazor.Web.Components
@using MudBlazor
@using MudBlazorWeb.Shared.Models

@inject IState<PostsState> PostsState
@inject IDispatcher Dispatcher
@inject NavigationManager NavigationManager

@inherits FluxorComponent

<div class="div-page-content">
    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <span class="heading-meta">Posts</span>
            <MudText Typo="Typo.h4" GutterBottom="true" Class="ttl-heading">Latest Posts</MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => NavigationManager.NavigateTo("/posts/create"))">
            Create Post
        </MudButton>
    </div>

    <div class="posts-container">
        @if (PostsState.Value.IsLoading)
        {
            <div class="text-center py-5">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                <MudText Typo="Typo.body1" Class="mt-3">Loading posts...</MudText>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(PostsState.Value.ErrorMessage))
        {
            <MudAlert Severity="MudBlazor.Severity.Error" Class="mb-4">
                @PostsState.Value.ErrorMessage
            </MudAlert>
        }
        else if (PostsState.Value.Posts.Count == 0)
        {
            <MudAlert Severity="MudBlazor.Severity.Info">No posts found.</MudAlert>
        }
        else
        {
            <div class="posts-grid">
                @foreach (var post in PostsState.Value.Posts)
                {
                    <MudCard Class="post-card" Elevation="2">
                        <MudCardContent>
                            <MudText Typo="Typo.h5" Class="post-title">@post.Title</MudText>

                            @if (!string.IsNullOrWhiteSpace(post.Category))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="mt-2">
                                    @post.Category
                                </MudChip>
                            }

                            @if (!string.IsNullOrWhiteSpace(post.Description))
                            {
                                <MudText Typo="Typo.body2" Class="mt-3 post-description">
                                    @post.Description
                                </MudText>
                            }

                            <MudDivider Class="my-3" />

                            <div class="post-stats">
                                <div class="stat-item">
                                    <MudIcon Icon="@Icons.Material.Filled.ThumbUp" Size="Size.Small" />
                                    <MudText Typo="Typo.body2">@(post.TotalLikes ?? 0)</MudText>
                                </div>

                                <div class="stat-item">
                                    <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" />
                                    <MudText Typo="Typo.body2">@(post.TotalViews ?? 0)</MudText>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(post.PostedOn))
                                {
                                    <div class="stat-item">
                                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" />
                                        <MudText Typo="Typo.body2">@FormatDate(post.PostedOn)</MudText>
                                    </div>
                                }
                            </div>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => ViewPostDetails(post))">
                                Read More
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                }
            </div>

            @if (PostsState.Value.TotalPages > 1)
            {
                <div class="pagination-container mt-4">
                    <MudPagination Count="@PostsState.Value.TotalPages"
                                   Selected="@PostsState.Value.CurrentPage"
                                   SelectedChanged="@OnPageChanged"
                                   Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   ShowFirstButton="true"
                                   ShowLastButton="true" />
                </div>
            }
        }
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        Dispatcher.Dispatch(new LoadPostsAction(1, 12));
    }

    private void OnPageChanged(int newPage)
    {
        Dispatcher.Dispatch(new ChangePageAction(newPage));
    }

    private void ViewPostDetails(PostResponse post)
    {
        if (!string.IsNullOrWhiteSpace(post.ID))
        {
            NavigationManager.NavigateTo($"/posts/{post.ID}");
        }
    }

    private static string FormatDate(string? dateString)
    {
        if (string.IsNullOrWhiteSpace(dateString))
        {
            return "Unknown";
        }

        return DateTime.TryParse(dateString, out var date)
            ? date.ToString("MMM dd, yyyy")
            : dateString;
    }
}

<style>
    .posts-container {
        width: 100%;
    }

    .posts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 24px;
        margin-top: 24px;
    }

    .post-card {
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .post-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
    }

    .post-title {
        font-weight: 600;
        color: var(--mud-palette-text-primary);
        min-height: 60px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .post-description {
        color: var(--mud-palette-text-secondary);
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 60px;
    }

    .post-stats {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        align-items: center;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--mud-palette-text-secondary);
    }

    .stat-item .mud-icon-root {
        color: var(--mud-palette-primary);
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        margin-top: 32px;
    }

    @@media (max-width: 768px) {
        .posts-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .post-stats {
            gap: 12px;
            font-size: 0.875rem;
        }
    }
</style>
