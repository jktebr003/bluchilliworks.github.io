@page "/posts/{PostId}"

@using Fluxor
@using Fluxor.Blazor.Web.Components
@using MudBlazor
@using MudBlazorWeb.Shared.Models

@inject IState<PostsState> PostsState
@inject IDispatcher Dispatcher
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

@inherits FluxorComponent
@implements IDisposable

<div class="div-page-content">
    <span class="heading-meta">@(isEditMode ? "Edit Post" : "Post Details")</span>
    <MudText Typo="Typo.h4" GutterBottom="true" Class="ttl-heading">@(isEditMode ? "Edit Post" : "Post Details")</MudText>

    @if (showSuccessAlert)
    {
        <MudAlert Severity="MudBlazor.Severity.Success"
                  Class="mb-4"
                  ShowCloseIcon="true"
                  CloseIcon="@Icons.Material.Filled.Close"
                  CloseIconClicked="@(() => showSuccessAlert = false)">
            Post updated successfully!
        </MudAlert>
    }

    @if (showErrorAlert && !string.IsNullOrWhiteSpace(PostsState.Value.DetailErrorMessage))
    {
        <MudAlert Severity="MudBlazor.Severity.Error"
                  Class="mb-4"
                  ShowCloseIcon="true"
                  CloseIcon="@Icons.Material.Filled.Close"
                  CloseIconClicked="@(() => showErrorAlert = false)">
            @PostsState.Value.DetailErrorMessage
        </MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => NavigationManager.NavigateTo("/posts"))">
            Back to Posts
        </MudButton>
    }

    @if (PostsState.Value.IsLoadingDetail || isAwaitingFirstLoad)
    {
        <div class="text-center py-5">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Class="mt-3">Loading post...</MudText>
        </div>
    }
    else if (currentPost == null)
    {
        <MudAlert Severity="MudBlazor.Severity.Warning">Post not found.</MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => NavigationManager.NavigateTo("/posts"))">
            Back to Posts
        </MudButton>
    }
    else
    {
        <div class="post-detail-container">
            <div class="d-flex justify-space-between align-center mb-4">
                <MudSpacer />
                <div>
                    @if (!isEditMode)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="@EnableEditMode">
                            Edit Post
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Default"
                                   OnClick="@CancelEdit"
                                   Class="mr-2">
                            Cancel
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="@SavePost"
                                   Disabled="@PostsState.Value.IsUpdating">
                            @(PostsState.Value.IsUpdating ? "Saving..." : "Save Changes")
                        </MudButton>
                    }
                </div>
            </div>

            <MudForm @ref="form" @bind-IsValid="@isFormValid">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudGrid>
                        <MudItem xs="12">
                            @if (isEditMode)
                            {
                                <MudTextField @bind-Value="currentPost.Title"
                                              Label="Title"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              RequiredError="Title is required"
                                              Lines="1" />
                            }
                            else
                            {
                                <div class="detail-field">
                                    <MudText Typo="Typo.subtitle2" Class="field-label">Title</MudText>
                                    <MudText Typo="Typo.h5">@currentPost.Title</MudText>
                                </div>
                            }
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            @if (isEditMode)
                            {
                                <MudTextField @bind-Value="currentPost.Category"
                                              Label="Category"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              RequiredError="Category is required" />
                            }
                            else
                            {
                                <div class="detail-field">
                                    <MudText Typo="Typo.subtitle2" Class="field-label">Category</MudText>
                                    <MudChip T="string" Color="Color.Primary">@currentPost.Category</MudChip>
                                </div>
                            }
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            @if (isEditMode)
                            {
                                <MudTextField @bind-Value="currentPost.Author"
                                              Label="Author"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              RequiredError="Author is required" />
                            }
                            else
                            {
                                <div class="detail-field">
                                    <MudText Typo="Typo.subtitle2" Class="field-label">Author</MudText>
                                    <MudText Typo="Typo.body1">@currentPost.Author</MudText>
                                </div>
                            }
                        </MudItem>

                        <MudItem xs="12">
                            @if (isEditMode)
                            {
                                <MudTextField @bind-Value="currentPost.Heading"
                                              Label="Heading"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              RequiredError="Heading is required"
                                              Lines="2" />
                            }
                            else
                            {
                                <div class="detail-field">
                                    <MudText Typo="Typo.subtitle2" Class="field-label">Heading</MudText>
                                    <MudText Typo="Typo.h6">@currentPost.Heading</MudText>
                                </div>
                            }
                        </MudItem>

                        <MudItem xs="12">
                            @if (isEditMode)
                            {
                                <MudTextField @bind-Value="currentPost.Description"
                                              Label="Description"
                                              Variant="Variant.Outlined"
                                              Lines="3" />
                            }
                            else
                            {
                                <div class="detail-field">
                                    <MudText Typo="Typo.subtitle2" Class="field-label">Description</MudText>
                                    <MudText Typo="Typo.body1">@currentPost.Description</MudText>
                                </div>
                            }
                        </MudItem>

                        <MudItem xs="12">
                            @if (isEditMode)
                            {
                                <MudTextField @bind-Value="currentPost.Content"
                                              Label="Content"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              RequiredError="Content is required"
                                              Lines="10" />
                            }
                            else
                            {
                                <div class="detail-field">
                                    <MudText Typo="Typo.subtitle2" Class="field-label">Content</MudText>
                                    <MudPaper Class="pa-3 content-display" Elevation="0">
                                        <MudText Typo="Typo.body1" Style="white-space: pre-wrap;">@currentPost.Content</MudText>
                                    </MudPaper>
                                </div>
                            }
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider Class="my-3" />
                            <MudText Typo="Typo.subtitle2" Class="field-label mb-2">Post Statistics</MudText>
                            <div class="post-stats">
                                <div class="stat-item">
                                    <MudIcon Icon="@Icons.Material.Filled.ThumbUp" Size="Size.Small" />
                                    <MudText Typo="Typo.body2">@(currentPost.TotalLikes ?? 0) Likes</MudText>
                                </div>
                                <div class="stat-item">
                                    <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" />
                                    <MudText Typo="Typo.body2">@(currentPost.TotalViews ?? 0) Views</MudText>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(currentPost.PostedOn))
                                {
                                    <div class="stat-item">
                                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" />
                                        <MudText Typo="Typo.body2">Posted: @FormatDate(currentPost.PostedOn)</MudText>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(currentPost.ModifiedOn))
                                {
                                    <div class="stat-item">
                                        <MudIcon Icon="@Icons.Material.Filled.Update" Size="Size.Small" />
                                        <MudText Typo="Typo.body2">Modified: @FormatDate(currentPost.ModifiedOn)</MudText>
                                    </div>
                                }
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudForm>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? PostId { get; set; }

    private MudForm? form;
    private bool isFormValid;
    private bool isEditMode;
    private PostResponse? currentPost;
    private PostResponse? originalPost;
    private bool showSuccessAlert;
    private bool showErrorAlert;
    private bool wasLoading;
    private bool isUpdateOperation;
    private string? lastRequestedPostId;
    private bool isAwaitingFirstLoad;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        PostsState.StateChanged += OnStateChanged;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (!string.IsNullOrWhiteSpace(PostId) && !string.Equals(PostId, lastRequestedPostId, StringComparison.OrdinalIgnoreCase))
        {
            lastRequestedPostId = PostId;
            isAwaitingFirstLoad = true;
            currentPost = null;
            originalPost = null;
            isEditMode = false;
            showErrorAlert = false;
            showSuccessAlert = false;
            isUpdateOperation = false;
            Dispatcher.Dispatch(new LoadPostDetailAction(PostId));
        }
    }

    private void EnableEditMode()
    {
        if (currentPost == null)
        {
            return;
        }

        isEditMode = true;
        isUpdateOperation = false;
        originalPost = ClonePost(currentPost);
    }

    private void CancelEdit()
    {
        isEditMode = false;
        isUpdateOperation = false;

        if (originalPost != null)
        {
            currentPost = ClonePost(originalPost);
        }
    }

    private async Task SavePost()
    {
        showSuccessAlert = false;
        showErrorAlert = false;
        isUpdateOperation = true;

        if (form != null)
        {
            await form.Validate();
            if (!isFormValid)
            {
                Snackbar.Add("Please fix validation errors", MudBlazor.Severity.Error);
                return;
            }
        }

        if (currentPost == null || string.IsNullOrWhiteSpace(currentPost.ID))
        {
            Snackbar.Add("Invalid post data", MudBlazor.Severity.Error);
            return;
        }

        var request = new UpdatePostRequest
        {
            Id = currentPost.ID,
            Title = currentPost.Title,
            Heading = currentPost.Heading,
            Description = currentPost.Description,
            Content = currentPost.Content,
            Author = currentPost.Author,
            UserId = currentPost.UserId,
            Category = currentPost.Category,
            TotalViews = currentPost.TotalViews,
            ModifiedOn = DateTime.UtcNow,
            ModifiedBy = "system"
        };

        Dispatcher.Dispatch(new UpdatePostAction(request));
    }

    private void OnStateChanged(object? sender, EventArgs e)
    {
        bool justFinishedLoading = wasLoading && !PostsState.Value.IsLoadingDetail;

        if (justFinishedLoading)
        {
            wasLoading = false;
            isAwaitingFirstLoad = false;
            currentPost = PostsState.Value.CurrentPost == null ? null : ClonePost(PostsState.Value.CurrentPost);

            if (!string.IsNullOrWhiteSpace(PostsState.Value.DetailErrorMessage))
            {
                showErrorAlert = true;
                showSuccessAlert = false;
                originalPost = null;
                isEditMode = false;
            }
            else if (PostsState.Value.CurrentPost != null && isUpdateOperation)
            {
                showSuccessAlert = true;
                showErrorAlert = false;
                isEditMode = false;
                currentPost = ClonePost(PostsState.Value.CurrentPost);
                originalPost = ClonePost(PostsState.Value.CurrentPost);
            }
            else if (PostsState.Value.CurrentPost != null)
            {
                showErrorAlert = false;
                originalPost = ClonePost(PostsState.Value.CurrentPost);
            }

            isUpdateOperation = false;
            InvokeAsync(StateHasChanged);
        }
        else if (PostsState.Value.IsLoadingDetail && !wasLoading)
        {
            wasLoading = true;
            InvokeAsync(StateHasChanged);
        }
    }

    private static PostResponse ClonePost(PostResponse source)
    {
        return new PostResponse
        {
            ID = source.ID,
            Title = source.Title,
            Heading = source.Heading,
            Description = source.Description,
            Content = source.Content,
            Author = source.Author,
            UserId = source.UserId,
            Category = source.Category,
            TotalViews = source.TotalViews,
            TotalLikes = source.TotalLikes,
            TotalComments = source.TotalComments,
            PostedOn = source.PostedOn,
            CreatedOn = source.CreatedOn,
            CreatedBy = source.CreatedBy,
            ModifiedOn = source.ModifiedOn,
            ModifiedBy = source.ModifiedBy,
            DeletedOn = source.DeletedOn,
            DeletedBy = source.DeletedBy,
            IsDeleted = source.IsDeleted
        };
    }

    private static string FormatDate(string? dateString)
    {
        if (string.IsNullOrWhiteSpace(dateString))
        {
            return "Unknown";
        }

        return DateTime.TryParse(dateString, out var date)
            ? date.ToString("MMMM dd, yyyy 'at' hh:mm tt")
            : dateString;
    }

    public void Dispose()
    {
        PostsState.StateChanged -= OnStateChanged;
    }
}

<style>
    .post-detail-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .detail-field {
        margin-bottom: 16px;
    }

    .field-label {
        font-weight: 600;
        color: var(--mud-palette-text-secondary);
        margin-bottom: 8px;
        display: block;
    }

    .content-display {
        background-color: var(--mud-palette-background-grey);
        border: 1px solid var(--mud-palette-lines-default);
    }

    .post-stats {
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
        align-items: center;
        padding: 16px;
        background-color: var(--mud-palette-background-grey);
        border-radius: 4px;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--mud-palette-text-secondary);
    }

    .stat-item .mud-icon-root {
        color: var(--mud-palette-primary);
    }

    @@media (max-width: 768px) {
        .post-stats {
            gap: 16px;
        }

        .stat-item {
            font-size: 0.875rem;
        }
    }
</style>
