@page "/contact"

@using Fluxor
@using Fluxor.Blazor.Web.Components
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using MudBlazorWeb.Infrastructure
@using MudBlazorWeb.Shared
@using MudBlazorWeb.Shared.Models

@inject IState<ContactState> ContactState
@inject IDispatcher Dispatcher

@inherits FluxorComponent

<div>
    <div class="div-page-content">
        <span class="heading-meta">Contact</span>
        <MudText Typo="Typo.h4" GutterBottom="true" class="ttl-heading">Get in touch</MudText>

        <div class="ttl-contact">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <div>
                        <MudCard Class="pb-3 div-contact" Elevation="2">
                            <MudCardContent>
                                <div class="mb-2">
                                    <MudText Typo="Typo.caption">* indicates a required field</MudText>
                                </div>

                                <EditForm Model="@contactModel" OnValidSubmit="HandleValidSubmit">
                                    <DataAnnotationsValidator />
                                    <MudStack Spacing="2">
                                        <MudTextField T="string"
                                                      Label="Name *"
                                                      Variant="Variant.Outlined"
                                                      For="@(() => contactModel.Name)"
                                                      @bind-Value="contactModel.Name" />

                                        <MudTextField T="string"
                                                      Label="Email Address *"
                                                      Variant="Variant.Outlined"
                                                      For="@(() => contactModel.Email)"
                                                      @bind-Value="contactModel.Email" />

                                        <MudTextField T="string"
                                                      Label="Subject *"
                                                      Variant="Variant.Outlined"
                                                      For="@(() => contactModel.Subject)"
                                                      @bind-Value="contactModel.Subject" />

                                        <MudTextField T="string"
                                                      Label="Message *"
                                                      Variant="Variant.Outlined"
                                                      Lines="6"
                                                      For="@(() => contactModel.Message)"
                                                      @bind-Value="contactModel.Message" />

                                        <MudButton ButtonType="ButtonType.Submit"
                                                   Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Disabled="@ContactState.Value.IsSubmitting"
                                                   FullWidth="false">
                                            @if (ContactState.Value.IsSubmitting)
                                            {
                                                <MudProgressCircular Class="me-2"
                                                                     Color="Color.Inherit"
                                                                     Size="Size.Small"
                                                                     Indeterminate="true" />
                                                <span>Sending...</span>
                                            }
                                            else
                                            {
                                                <span>Send</span>
                                            }
                                        </MudButton>
                                    </MudStack>
                                </EditForm>

                                @if (ContactState.Value.SuccessMessage != null)
                                {
                                    <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Dense="true" Class="mt-3">
                                        @ContactState.Value.SuccessMessage
                                    </MudAlert>
                                }
                                @if (ContactState.Value.ErrorMessage != null)
                                {
                                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mt-3">
                                        @ContactState.Value.ErrorMessage
                                    </MudAlert>
                                }
                            </MudCardContent>
                        </MudCard>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="6">
                    @* <div class="div-contact-image">
                        <MudImage Src="img/connect-with-us-alt.png" Alt="connect-with-us" Height="500" ObjectFit="ObjectFit.Cover" ObjectPosition="ObjectPosition.Center" />
                    </div> *@
                </MudItem>
            </MudGrid>
        </div>

    </div>
</div>

@code {
    private ContactModel contactModel = new();
    private string? lastSuccessMessage;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (!string.IsNullOrWhiteSpace(ContactState.Value.SuccessMessage)
            && ContactState.Value.SuccessMessage != lastSuccessMessage)
        {
            contactModel = new();
            lastSuccessMessage = ContactState.Value.SuccessMessage;
        }
    }

    private Task HandleValidSubmit()
    {
        var request = new CreateMessageRequest
        {
            From = contactModel.Name,
            EmailAddress = contactModel.Email,
            Subject = contactModel.Subject,
            Body = contactModel.Message,
            SentOn = DateTime.UtcNow.ToString("o"),
            CreatedBy = "web-contact-form"
        };

        Dispatcher.Dispatch(new SubmitContactMessageAction(request));
        return Task.CompletedTask;
    }

    public class ContactModel
    {
        [Required(ErrorMessage = "Name is required")]
        public string? Name { get; set; }

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string? Email { get; set; }

        [Required(ErrorMessage = "Subject is required")]
        public string? Subject { get; set; }

        [Required(ErrorMessage = "Message is required")]
        public string? Message { get; set; }
    }
}
