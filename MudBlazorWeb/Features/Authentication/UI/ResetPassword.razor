@page "/authentication/reset-password"

@using System.ComponentModel.DataAnnotations
@using Fluxor
@using Fluxor.Blazor.Web.Components
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using MudBlazorWeb.Features.Authentication.UI
@using MudBlazorWeb.Shared.Components

@inject IState<AuthenticationState> AuthState
@inject IDispatcher Dispatcher
@inject NavigationManager NavigationManager

@inherits FluxorComponent

<div>
    <div>
        <MudText Typo="Typo.caption" Class="heading-meta">Password Reset</MudText>
        <MudText Typo="Typo.h4" GutterBottom="true" class="ttl-heading">Reset Your Password</MudText>

        <div>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudCard Class="pb-3 div-login" style="height:100%">
                        <MudCardMedia Image="img/reset-password.png" />
                        <MudCardContent>
                            <div class="mb-2">
                                <MudText Typo="Typo.caption">* indicates a required field</MudText>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(AuthState.Value.ErrorMessage))
                            {
                                <MudAlert Severity="Severity.Error" Class="mb-3">@AuthState.Value.ErrorMessage</MudAlert>
                            }
                            
                            <EditForm Model="resetPasswordModel" OnValidSubmit="OnResetPassword">
                                <DataAnnotationsValidator />
                                <ValidationSummary />

                                <MudTextField T="string"
                                              Label="Email Address *"
                                              Placeholder="Enter your email address"
                                              InputType="InputType.Email"
                                              ReadOnly="@(!string.IsNullOrEmpty(emailFromUrl))"
                                              Class="mb-3 login-input"
                                              Variant="Variant.Outlined"
                                              FullWidth="true"
                                              For="@(() => resetPasswordModel.EmailAddress)"
                                              @bind-Value="resetPasswordModel.EmailAddress" />

                                <MudTextField T="string"
                                              Label="Reset Code *"
                                              Placeholder="Enter the 6-digit code from your email"
                                              ReadOnly="@(!string.IsNullOrEmpty(tokenFromUrl))"
                                              Class="mb-3 login-input"
                                              Variant="Variant.Outlined"
                                              FullWidth="true"
                                              For="@(() => resetPasswordModel.ResetToken)"
                                              @bind-Value="resetPasswordModel.ResetToken" />

                                <MudTextField T="string"
                                              Label="New Password *"
                                              Placeholder="Enter your new password"
                                              InputType="InputType.Password"
                                              Class="mb-1 login-input"
                                              Variant="Variant.Outlined"
                                              FullWidth="true"
                                              For="@(() => resetPasswordModel.NewPassword)"
                                              @bind-Value="resetPasswordModel.NewPassword" />

                                <MudText Typo="Typo.caption" Class="mb-3 text-muted">
                                    Password must be at least 8 characters and contain uppercase, lowercase, number, and special character.
                                </MudText>

                                <MudTextField T="string"
                                              Label="Confirm Password *"
                                              Placeholder="Confirm your new password"
                                              InputType="InputType.Password"
                                              Class="mb-3 login-input"
                                              Variant="Variant.Outlined"
                                              FullWidth="true"
                                              For="@(() => resetPasswordModel.ConfirmPassword)"
                                              @bind-Value="resetPasswordModel.ConfirmPassword" />

                                <MudButton ButtonType="ButtonType.Submit"
                                           Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           FullWidth="true"
                                           Class="login-btn"
                                           Disabled="@AuthState.Value.IsBusy">
                                    @if (AuthState.Value.IsBusy)
                                    {
                                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" />
                                        <span>Resetting...</span>
                                    }
                                    else
                                    {
                                        <span>Reset Password</span>
                                    }
                                </MudButton>
                            </EditForm>
                            
                            <MudStack Spacing="2" Class="d-flex justify-content-between mt-3">
                                <MudLink Href="/authentication/forgot-password" Class="login-link">Resend Reset Code</MudLink>
                                <MudLink Href="/authentication/login" Class="login-link">Back to Login</MudLink>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <div class="div-login-register-form">
                        <div class="div-login-register-form-contents">
                            <MudText Typo="Typo.h6" GutterBottom="true" class="ttl-sub-heading">Create a Strong Password</MudText>
                            <MudText Typo="Typo.body1">Your new password should:</MudText>
                            <MudList T="string" Dense="true" Class="password-requirements">
                                <MudListItem T="string" Class="@(HasMinLength ? "valid" : "")">Be at least 8 characters long</MudListItem>
                                <MudListItem T="string" Class="@(HasUppercase ? "valid" : "")">Contain an uppercase letter</MudListItem>
                                <MudListItem T="string" Class="@(HasLowercase ? "valid" : "")">Contain a lowercase letter</MudListItem>
                                <MudListItem T="string" Class="@(HasNumber ? "valid" : "")">Contain a number</MudListItem>
                                <MudListItem T="string" Class="@(HasSpecialChar ? "valid" : "")">Contain a special character</MudListItem>
                                <MudListItem T="string" Class="@(PasswordsMatch ? "valid" : "")">Match the confirmation</MudListItem>
                            </MudList>
                        </div>
                    </div>
                </MudItem>
            </MudGrid>
        </div>
    </div>
</div>

<ProgressSpinner IsBusy="AuthState.Value.IsBusy" />

@code {
    private ResetPasswordModel resetPasswordModel = new();
    private string? emailFromUrl;
    private string? tokenFromUrl;

    private bool HasMinLength => !string.IsNullOrEmpty(resetPasswordModel.NewPassword) && resetPasswordModel.NewPassword.Length >= 8;
    private bool HasUppercase => !string.IsNullOrEmpty(resetPasswordModel.NewPassword) && resetPasswordModel.NewPassword.Any(char.IsUpper);
    private bool HasLowercase => !string.IsNullOrEmpty(resetPasswordModel.NewPassword) && resetPasswordModel.NewPassword.Any(char.IsLower);
    private bool HasNumber => !string.IsNullOrEmpty(resetPasswordModel.NewPassword) && resetPasswordModel.NewPassword.Any(char.IsDigit);
    private bool HasSpecialChar => !string.IsNullOrEmpty(resetPasswordModel.NewPassword) && resetPasswordModel.NewPassword.Any(ch => !char.IsLetterOrDigit(ch));
    private bool PasswordsMatch => !string.IsNullOrEmpty(resetPasswordModel.NewPassword) && 
                                   !string.IsNullOrEmpty(resetPasswordModel.ConfirmPassword) && 
                                   resetPasswordModel.NewPassword == resetPasswordModel.ConfirmPassword;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        
        // Get email and token from URL query parameters
        var uri = new Uri(NavigationManager.Uri);
        var query = uri.Query;
        
        if (query.Contains("email="))
        {
            var emailStart = query.IndexOf("email=") + 6;
            var emailEnd = query.IndexOf("&", emailStart);
            emailFromUrl = emailEnd > 0 ? query.Substring(emailStart, emailEnd - emailStart) : query.Substring(emailStart);
            emailFromUrl = Uri.UnescapeDataString(emailFromUrl);
            resetPasswordModel.EmailAddress = emailFromUrl;
        }
        
        if (query.Contains("token="))
        {
            var tokenStart = query.IndexOf("token=") + 6;
            var tokenEnd = query.IndexOf("&", tokenStart);
            tokenFromUrl = tokenEnd > 0 ? query.Substring(tokenStart, tokenEnd - tokenStart) : query.Substring(tokenStart);
            tokenFromUrl = Uri.UnescapeDataString(tokenFromUrl);
            resetPasswordModel.ResetToken = tokenFromUrl;
        }
    }

    private void OnResetPassword()
    {
        if (resetPasswordModel.NewPassword != resetPasswordModel.ConfirmPassword)
        {
            return; // Validation will catch this
        }

        Dispatcher.Dispatch(new ResetPasswordAction(
            resetPasswordModel.EmailAddress,
            resetPasswordModel.ResetToken,
            resetPasswordModel.NewPassword
        ));
    }

    public class ResetPasswordModel : IValidatableObject
    {
        [Required(ErrorMessage = "Email address is required")]
        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string EmailAddress { get; set; } = string.Empty;

        [Required(ErrorMessage = "Reset code is required")]
        public string ResetToken { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters")]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).+$", 
            ErrorMessage = "Password must contain uppercase, lowercase, number, and special character")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password")]
        public string ConfirmPassword { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (NewPassword != ConfirmPassword)
            {
                yield return new ValidationResult("Passwords do not match", new[] { nameof(ConfirmPassword) });
            }
        }
    }
}
