@page "/authentication/forgot-password"

@using System.ComponentModel.DataAnnotations
@using Fluxor
@using Fluxor.Blazor.Web.Components
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using MudBlazorWeb.Features.Authentication.UI

@inject IState<AuthenticationState> AuthState
@inject IDispatcher Dispatcher
@inject NavigationManager NavigationManager

@inherits FluxorComponent

<div>
    <div>
        <span class="heading-meta">Password Recovery</span>
        <MudText Typo="Typo.h4" GutterBottom="true" class="ttl-heading">Forgot Password</MudText>

        <div>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudCard Class="pb-3 div-login" style="height:100%">
                        <MudCardMedia Image="img/forgot-password.png" />
                        <MudCardContent>
                            <div class="mb-3">
                                <MudText Typo="Typo.body2" Class="mb-2">
                                    Enter your email address and we'll send you a link to reset your password.
                                </MudText>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(successMessage))
                            {
                                <MudAlert Severity="Severity.Success" Class="mb-3">@successMessage</MudAlert>
                            }
                            
                            @if (!string.IsNullOrEmpty(AuthState.Value.ErrorMessage))
                            {
                                <MudAlert Severity="Severity.Error" Class="mb-3">@AuthState.Value.ErrorMessage</MudAlert>
                            }
                            
                            @if (string.IsNullOrEmpty(successMessage))
                            {
                                <EditForm Model="forgotPasswordModel" OnValidSubmit="OnForgotPassword">
                                    <DataAnnotationsValidator />
                                    <ValidationSummary />

                                    <div class="mb-3">
                                        <label for="email" class="form-label">Email Address *</label>
                                        <InputText id="email" class="form-control login-input" @bind-Value="forgotPasswordModel.EmailAddress" placeholder="Enter your email address" />
                                        <ValidationMessage For="@(() => forgotPasswordModel.EmailAddress)" />
                                    </div>

                                    <button type="submit" class="btn btn-primary w-100 login-btn" disabled="@AuthState.Value.IsBusy">
                                        @if (AuthState.Value.IsBusy)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                            <span>Sending...</span>
                                        }
                                        else
                                        {
                                            <span>Send Reset Link</span>
                                        }
                                    </button>
                                </EditForm>
                            }
                            
                            <div class="d-flex justify-content-center mt-3">
                                <a href="/authentication/login" class="login-link">Back to Login</a>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <div class="div-login-register-form">
                        <div class="div-login-register-form-contents">
                            <MudText Typo="Typo.h6" GutterBottom="true" class="ttl-sub-heading">Password Recovery</MudText>
                            <p>We'll help you get back into your account</p>
                            <ul class="password-reset-info">
                                <li>Enter your email address</li>
                                <li>Check your inbox for the reset link</li>
                                <li>Click the link and create a new password</li>
                                <li>The link expires in 1 hour</li>
                            </ul>
                        </div>
                    </div>
                </MudItem>
            </MudGrid>
        </div>
    </div>
</div>

<ProgressSpinner IsBusy="AuthState.Value.IsBusy" />

@code {
    private ForgotPasswordModel forgotPasswordModel = new();
    private string? successMessage;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        
        // Subscribe to state changes
        AuthState.StateChanged += OnStateChanged;
    }

    private void OnStateChanged(object? sender, EventArgs e)
    {
        // Check if forgot password was successful
        if (!AuthState.Value.IsBusy && string.IsNullOrEmpty(AuthState.Value.ErrorMessage))
        {
            // Action might have succeeded - check if we got here from the forgot password effect
            // This is handled in the effects now, but we can show success message
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnForgotPassword()
    {
        successMessage = null;
        Dispatcher.Dispatch(new ForgotPasswordAction(forgotPasswordModel.EmailAddress));
        
        // Show success message (even if user doesn't exist for security)
        Task.Delay(500).ContinueWith(_ => 
        {
            successMessage = "If an account with that email exists, you will receive a password reset link shortly.";
            InvokeAsync(StateHasChanged);
        });
    }

    public void Dispose()
    {
        AuthState.StateChanged -= OnStateChanged;
    }

    public class ForgotPasswordModel
    {
        [Required(ErrorMessage = "Email address is required")]
        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string EmailAddress { get; set; } = string.Empty;
    }
}
