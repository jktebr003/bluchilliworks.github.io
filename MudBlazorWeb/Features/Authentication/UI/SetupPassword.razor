@page "/authentication/setup-password"

@using System.ComponentModel.DataAnnotations
@using Fluxor
@using Fluxor.Blazor.Web.Components
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using MudBlazorWeb.Features.Authentication.UI
@using MudBlazorWeb.Shared.Components

@inject IState<AuthenticationState> AuthState
@inject IDispatcher Dispatcher
@inject NavigationManager NavigationManager

@inherits FluxorComponent

<div>
    <div>
        <MudText Typo="Typo.caption" Class="heading-meta">Setup Password</MudText>
        <MudText Typo="Typo.h4" GutterBottom="true" class="ttl-heading">Create Your Password</MudText>

        <div>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudCard Class="pb-3 div-login" style="height:100%">
                        <MudCardMedia Image="img/join-us-today.png" />
                        <MudCardContent>
                            <div class="mb-2">
                                <MudText Typo="Typo.caption">* indicates a required field</MudText>
                            </div>
                            @if (!string.IsNullOrEmpty(AuthState.Value.ErrorMessage))
                            {
                                <MudAlert Severity="Severity.Error" Class="mb-3">@AuthState.Value.ErrorMessage</MudAlert>
                            }
                            @if (!string.IsNullOrEmpty(successMessage))
                            {
                                <MudAlert Severity="Severity.Success" Class="mb-3">@successMessage</MudAlert>
                            }
                            <EditForm Model="setupPasswordModel" OnValidSubmit="OnSetupPassword">
                                <DataAnnotationsValidator />
                                <ValidationSummary />

                                <MudTextField T="string"
                                              Label="Email Address *"
                                              Placeholder="Enter your email address"
                                              InputType="InputType.Email"
                                              ReadOnly="@(!string.IsNullOrEmpty(emailFromUrl))"
                                              Class="mb-3 login-input"
                                              Variant="Variant.Outlined"
                                              FullWidth="true"
                                              For="@(() => setupPasswordModel.EmailAddress)"
                                              @bind-Value="setupPasswordModel.EmailAddress" />

                                <MudTextField T="string"
                                              Label="Verification Code *"
                                              Placeholder="Enter the 6-digit code from your email"
                                              Class="mb-3 login-input"
                                              Variant="Variant.Outlined"
                                              FullWidth="true"
                                              For="@(() => setupPasswordModel.VerificationToken)"
                                              @bind-Value="setupPasswordModel.VerificationToken" />

                                <MudTextField T="string"
                                              Label="Password *"
                                              Placeholder="Create a strong password"
                                              InputType="InputType.Password"
                                              Class="mb-1 login-input"
                                              Variant="Variant.Outlined"
                                              FullWidth="true"
                                              For="@(() => setupPasswordModel.Password)"
                                              @bind-Value="setupPasswordModel.Password" />

                                <MudText Typo="Typo.caption" Class="mb-3 text-muted">
                                    Password must be at least 8 characters and include uppercase, lowercase, number, and special character.
                                </MudText>

                                <MudTextField T="string"
                                              Label="Confirm Password *"
                                              Placeholder="Re-enter your password"
                                              InputType="InputType.Password"
                                              Class="mb-3 login-input"
                                              Variant="Variant.Outlined"
                                              FullWidth="true"
                                              For="@(() => setupPasswordModel.ConfirmPassword)"
                                              @bind-Value="setupPasswordModel.ConfirmPassword" />

                                <MudButton ButtonType="ButtonType.Submit"
                                           Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           FullWidth="true"
                                           Class="login-btn"
                                           Disabled="@AuthState.Value.IsBusy">
                                    @if (AuthState.Value.IsBusy)
                                    {
                                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" />
                                        <span>Setting Password...</span>
                                    }
                                    else
                                    {
                                        <span>Set Password & Verify Email</span>
                                    }
                                </MudButton>
                            </EditForm>

                            <div class="mt-3 text-center">
                                <MudText Typo="Typo.body2" Class="mb-2">Didn't receive the code?</MudText>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="OnResendVerification" Disabled="@AuthState.Value.IsBusy">
                                    Resend Verification Email
                                </MudButton>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <div class="div-login-register-form">
                        <div class="div-login-register-form-contents">
                            <MudText Typo="Typo.h6" GutterBottom="true" class="ttl-sub-heading">Complete Your Registration</MudText>
                            <MudText Typo="Typo.body1">Create a strong password to secure your account and start using BluChilliWorks.</MudText>
                            <MudFab Color="Color.Transparent" Style="margin-top: 2rem; color: black; border: 2px solid black" StartIcon="@Icons.Material.Filled.Login" Label="Back to Login" Href="/authentication/login" />
                        </div>
                    </div>
                </MudItem>
            </MudGrid>
        </div>
    </div>
</div>

<ProgressSpinner IsBusy="AuthState.Value.IsBusy" />

@code {
    private SetupPasswordModel setupPasswordModel = new();
    private string? emailFromUrl;
    private string? tokenFromUrl;
    private string? successMessage;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        
        // Get query parameters from URL
        var uri = new Uri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        
        emailFromUrl = query["email"];
        tokenFromUrl = query["token"];

        if (!string.IsNullOrEmpty(emailFromUrl))
        {
            setupPasswordModel.EmailAddress = emailFromUrl;
        }
        
        if (!string.IsNullOrEmpty(tokenFromUrl))
        {
            setupPasswordModel.VerificationToken = tokenFromUrl;
        }
    }

    private void OnSetupPassword()
    {
        Dispatcher.Dispatch(new SetPasswordAction(
            setupPasswordModel.EmailAddress, 
            setupPasswordModel.VerificationToken, 
            setupPasswordModel.Password));
    }

    private void OnResendVerification()
    {
        if (string.IsNullOrEmpty(setupPasswordModel.EmailAddress))
        {
            Dispatcher.Dispatch(new AuthenticationFailedAction("Please enter your email address first"));
            return;
        }
        
        Dispatcher.Dispatch(new ResendVerificationAction(setupPasswordModel.EmailAddress));
        successMessage = "Verification email sent! Please check your inbox.";
        StateHasChanged();
    }

    public class SetupPasswordModel
    {
        [Required(ErrorMessage = "Email address is required")]
        [EmailAddress(ErrorMessage = "Invalid email address format")]
        public string EmailAddress { get; set; } = string.Empty;

        [Required(ErrorMessage = "Verification code is required")]
        [StringLength(6, MinimumLength = 6, ErrorMessage = "Verification code must be 6 digits")]
        public string VerificationToken { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Password must be at least 8 characters long")]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).+$", 
            ErrorMessage = "Password must contain at least one uppercase letter, one lowercase letter, one number, and one special character")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
