@page "/authentication/setup-password"

@using System.ComponentModel.DataAnnotations
@using Fluxor
@using Fluxor.Blazor.Web.Components
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using MudBlazorWeb.Features.Authentication.UI

@inject IState<AuthenticationState> AuthState
@inject IDispatcher Dispatcher
@inject NavigationManager NavigationManager

@inherits FluxorComponent

<div>
    <div>
        <span class="heading-meta">Setup Password</span>
        <MudText Typo="Typo.h4" GutterBottom="true" class="ttl-heading">Create Your Password</MudText>

        <div>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudCard Class="pb-3 div-login" style="height:100%">
                        <MudCardMedia Image="img/join-us-today.png" />
                        <MudCardContent>
                            <div class="mb-2">
                                <MudText Typo="Typo.caption">* indicates a required field</MudText>
                            </div>
                            @if (!string.IsNullOrEmpty(AuthState.Value.ErrorMessage))
                            {
                                <div class="alert alert-danger mb-3">@AuthState.Value.ErrorMessage</div>
                            }
                            @if (!string.IsNullOrEmpty(successMessage))
                            {
                                <div class="alert alert-success mb-3">@successMessage</div>
                            }
                            <EditForm Model="setupPasswordModel" OnValidSubmit="OnSetupPassword">
                                <DataAnnotationsValidator />
                                <ValidationSummary />

                                <div class="mb-3">
                                    <label for="emailAddress" class="form-label">Email Address *</label>
                                    <InputText id="emailAddress" type="email" class="form-control login-input" @bind-Value="setupPasswordModel.EmailAddress" placeholder="Enter your email address" readonly="@(!string.IsNullOrEmpty(emailFromUrl))" />
                                    <ValidationMessage For="@(() => setupPasswordModel.EmailAddress)" />
                                </div>

                                <div class="mb-3">
                                    <label for="verificationToken" class="form-label">Verification Code *</label>
                                    <InputText id="verificationToken" class="form-control login-input" @bind-Value="setupPasswordModel.VerificationToken" placeholder="Enter the 6-digit code from your email" />
                                    <ValidationMessage For="@(() => setupPasswordModel.VerificationToken)" />
                                </div>

                                <div class="mb-3">
                                    <label for="password" class="form-label">Password *</label>
                                    <InputText id="password" type="password" class="form-control login-input" @bind-Value="setupPasswordModel.Password" placeholder="Create a strong password" />
                                    <ValidationMessage For="@(() => setupPasswordModel.Password)" />
                                    <small class="form-text text-muted">
                                        Password must be at least 8 characters and include uppercase, lowercase, number, and special character.
                                    </small>
                                </div>

                                <div class="mb-3">
                                    <label for="confirmPassword" class="form-label">Confirm Password *</label>
                                    <InputText id="confirmPassword" type="password" class="form-control login-input" @bind-Value="setupPasswordModel.ConfirmPassword" placeholder="Re-enter your password" />
                                    <ValidationMessage For="@(() => setupPasswordModel.ConfirmPassword)" />
                                </div>

                                <button type="submit" class="btn btn-primary w-100 login-btn" disabled="@AuthState.Value.IsBusy">
                                    @if (AuthState.Value.IsBusy)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Setting Password...</span>
                                    }
                                    else
                                    {
                                        <span>Set Password & Verify Email</span>
                                    }
                                </button>
                            </EditForm>

                            <div class="mt-3 text-center">
                                <p class="mb-2">Didn't receive the code?</p>
                                <button class="btn btn-link" @onclick="OnResendVerification" disabled="@AuthState.Value.IsBusy">
                                    Resend Verification Email
                                </button>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <div class="div-login-register-form">
                        <div class="div-login-register-form-contents">
                            <MudText Typo="Typo.h6" GutterBottom="true" class="ttl-sub-heading">Complete Your Registration</MudText>
                            <p>Create a strong password to secure your account and start using BluChilliWorks.</p>
                            <MudFab Color="Color.Transparent" Style="margin-top: 2rem; color: white; border: 2px solid white" StartIcon="@Icons.Material.Filled.Login" Label="Back to Login" Href="/authentication/login" />
                        </div>
                    </div>
                </MudItem>
            </MudGrid>
        </div>
    </div>
</div>

<ProgressSpinner IsBusy="AuthState.Value.IsBusy" />

@code {
    private SetupPasswordModel setupPasswordModel = new();
    private string? emailFromUrl;
    private string? tokenFromUrl;
    private string? successMessage;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        
        // Get query parameters from URL
        var uri = new Uri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        
        emailFromUrl = query["email"];
        tokenFromUrl = query["token"];

        if (!string.IsNullOrEmpty(emailFromUrl))
        {
            setupPasswordModel.EmailAddress = emailFromUrl;
        }
        
        if (!string.IsNullOrEmpty(tokenFromUrl))
        {
            setupPasswordModel.VerificationToken = tokenFromUrl;
        }
    }

    private void OnSetupPassword()
    {
        Dispatcher.Dispatch(new SetPasswordAction(
            setupPasswordModel.EmailAddress, 
            setupPasswordModel.VerificationToken, 
            setupPasswordModel.Password));
    }

    private void OnResendVerification()
    {
        if (string.IsNullOrEmpty(setupPasswordModel.EmailAddress))
        {
            Dispatcher.Dispatch(new AuthenticationFailedAction("Please enter your email address first"));
            return;
        }
        
        Dispatcher.Dispatch(new ResendVerificationAction(setupPasswordModel.EmailAddress));
        successMessage = "Verification email sent! Please check your inbox.";
        StateHasChanged();
    }

    public class SetupPasswordModel
    {
        [Required(ErrorMessage = "Email address is required")]
        [EmailAddress(ErrorMessage = "Invalid email address format")]
        public string EmailAddress { get; set; } = string.Empty;

        [Required(ErrorMessage = "Verification code is required")]
        [StringLength(6, MinimumLength = 6, ErrorMessage = "Verification code must be 6 digits")]
        public string VerificationToken { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Password must be at least 8 characters long")]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).+$", 
            ErrorMessage = "Password must contain at least one uppercase letter, one lowercase letter, one number, and one special character")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
