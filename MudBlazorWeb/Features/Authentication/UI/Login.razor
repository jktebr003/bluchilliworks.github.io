@page "/authentication/login"

@using System.ComponentModel.DataAnnotations
@using Fluxor
@using Fluxor.Blazor.Web.Components
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using MudBlazorWeb.Shared.Components
@using MudBlazorWeb.Features.Authentication.UI

@inject IState<AuthenticationState> AuthState
@inject IDispatcher Dispatcher
@inject NavigationManager NavigationManager

@inherits FluxorComponent

<div>
    <div>
        <MudText Typo="Typo.caption" Class="heading-meta">Login</MudText>
        <MudText Typo="Typo.h4" GutterBottom="true" class="ttl-heading">Sign-in</MudText>

        <div>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudCard Class="pb-3 div-login" style="height:100%">
                        <MudCardMedia Image="img/sign-in-to-our-community.png" />
                        <MudCardContent>
                            <div class="mb-2">
                                <MudText Typo="Typo.caption">* indicates a required field</MudText>
                            </div>
                            @if (!string.IsNullOrEmpty(AuthState.Value.ErrorMessage))
                            {
                                <MudAlert Severity="Severity.Error" Class="mb-3">@AuthState.Value.ErrorMessage</MudAlert>
                            }
                            <EditForm Model="loginModel" OnValidSubmit="OnLogin">
                                <DataAnnotationsValidator />

                                <MudTextField T="string"
                                              Label="Username *"
                                              Placeholder="Enter your username"
                                              Class="mb-3"
                                              Variant="Variant.Outlined"
                                              FullWidth="true"
                                              For="@(() => loginModel.Username)"
                                              @bind-Value="loginModel.Username" />

                                <MudTextField T="string"
                                              Label="Password *"
                                              Placeholder="Enter your password"
                                              InputType="InputType.Password"
                                              Class="mb-3"
                                              Variant="Variant.Outlined"
                                              FullWidth="true"
                                              For="@(() => loginModel.Password)"
                                              @bind-Value="loginModel.Password" />

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <MudLink Href="/authentication/forgot-password" Class="login-link">Forgot password?</MudLink>
                                </div>

                                <MudButton ButtonType="ButtonType.Submit"
                                           Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           FullWidth="true"
                                           Class="login-btn"
                                           Disabled="@AuthState.Value.IsBusy">
                                    @if (AuthState.Value.IsBusy)
                                    {
                                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" />
                                        <span>Signing in...</span>
                                    }
                                    else
                                    {
                                        <span>Sign In</span>
                                    }
                                </MudButton>
                            </EditForm>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <div class="div-login-register-form">
                        <div class="div-login-register-form-contents">
                            <MudText Typo="Typo.h6" GutterBottom="true" class="ttl-sub-heading">Welcome to login</MudText>
                            <MudText Typo="Typo.body1">Don't have an account?</MudText>
                            <MudFab Color="Color.Transparent" Style="margin-top: 2rem; color: black; border: 2px solid black" StartIcon="@Icons.Material.Filled.Edit" Label="Sign Up" Href="/authentication/register" />
                        </div>
                    </div>
                </MudItem>
            </MudGrid>
        </div>
    </div>
</div>

<ProgressSpinner IsBusy="AuthState.Value.IsBusy" />

@code {
    private LoginModel loginModel = new();

    private void OnLogin()
    {
        Dispatcher.Dispatch(new LoginAction(loginModel.Username, loginModel.Password));
    }

    public class LoginModel
    {
        [Required]
        public string Username { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}
