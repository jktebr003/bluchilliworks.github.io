@page "/authentication/register"

@using System.ComponentModel.DataAnnotations
@using Fluxor
@using Fluxor.Blazor.Web.Components
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using MudBlazorWeb.Shared.Components
@using MudBlazorWeb.Features.Authentication.UI

@inject IState<AuthenticationState> AuthState
@inject IDispatcher Dispatcher
@inject NavigationManager NavigationManager

@inherits FluxorComponent

<div>
    <div>
        <MudText Typo="Typo.caption" Class="heading-meta">Register</MudText>
        <MudText Typo="Typo.h4" GutterBottom="true" class="ttl-heading">Sign-up</MudText>

        <div>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudCard Class="pb-3 div-login" style="height:100%">
                        <MudCardMedia Image="img/join-us-today.png" />
                        <MudCardContent>
                            <div class="mb-2">
                                <MudText Typo="Typo.caption">* indicates a required field</MudText>
                            </div>
                            @if (!string.IsNullOrEmpty(AuthState.Value.ErrorMessage))
                            {
                                <MudAlert Severity="Severity.Error" Class="mb-3">@AuthState.Value.ErrorMessage</MudAlert>
                            }
                            <EditForm Model="registerModel" OnValidSubmit="OnRegister">
                                <DataAnnotationsValidator />

                                <MudTextField T="string"
                                              Label="First Name *"
                                              Placeholder="Enter your first name"
                                              Class="mb-3"
                                              Variant="Variant.Outlined"
                                              FullWidth="true"
                                              For="@(() => registerModel.FirstName)"
                                              @bind-Value="registerModel.FirstName" />

                                <MudTextField T="string"
                                              Label="Last Name *"
                                              Placeholder="Enter your last name"
                                              Class="mb-3"
                                              Variant="Variant.Outlined"
                                              FullWidth="true"
                                              For="@(() => registerModel.LastName)"
                                              @bind-Value="registerModel.LastName" />

                                <MudTextField T="string"
                                              Label="Email Address *"
                                              Placeholder="Enter your email address"
                                              InputType="InputType.Email"
                                              Class="mb-3"
                                              Variant="Variant.Outlined"
                                              FullWidth="true"
                                              For="@(() => registerModel.EmailAddress)"
                                              @bind-Value="registerModel.EmailAddress" />

                                <MudButton ButtonType="ButtonType.Submit"
                                           Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           FullWidth="true"
                                           Class="login-btn"
                                           Disabled="@AuthState.Value.IsBusy">
                                    @if (AuthState.Value.IsBusy)
                                    {
                                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" />
                                        <span>Creating Account...</span>
                                    }
                                    else
                                    {
                                        <span>Create Account</span>
                                    }
                                </MudButton>
                            </EditForm>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <div class="div-login-register-form">
                        <div class="div-login-register-form-contents">
                            <MudText Typo="Typo.h6" GutterBottom="true" class="ttl-sub-heading">Join BluChilliWorks</MudText>
                            <MudText Typo="Typo.body1">Already have an account?</MudText>
                            <MudFab Color="Color.Transparent" Style="margin-top: 2rem; color: var(--mud-palette-primary-text); border: 2px solid var(--mud-palette-primary-text);" StartIcon="@Icons.Material.Filled.Login" Label="Sign In" Href="/authentication/login" />
                        </div>
                    </div>
                </MudItem>
            </MudGrid>
        </div>
    </div>
</div>

<ProgressSpinner IsBusy="AuthState.Value.IsBusy" />

@code {
    private RegisterModel registerModel = new();

    private void OnRegister()
    {
        Dispatcher.Dispatch(new RegisterAction(registerModel.FirstName, registerModel.LastName, registerModel.EmailAddress));
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        
        // Subscribe to state changes to handle success
        AuthState.StateChanged += OnAuthStateChanged;
    }

    private void OnAuthStateChanged(object? sender, EventArgs e)
    {
        if (!AuthState.Value.IsBusy && string.IsNullOrEmpty(AuthState.Value.ErrorMessage))
        {
            // Registration was successful - show message
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        AuthState.StateChanged -= OnAuthStateChanged;
    }

    public class RegisterModel
    {
        [Required(ErrorMessage = "First name is required")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Last name is required")]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email address is required")]
        [EmailAddress(ErrorMessage = "Invalid email address format")]
        public string EmailAddress { get; set; } = string.Empty;
    }
}
