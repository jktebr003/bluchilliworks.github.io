@page "/authentication/resend-verification"

@using System.ComponentModel.DataAnnotations
@using Fluxor
@using Fluxor.Blazor.Web.Components
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using MudBlazorWeb.Features.Authentication.UI
@using MudBlazorWeb.Shared.Components

@inject IState<AuthenticationState> AuthState
@inject IDispatcher Dispatcher
@inject NavigationManager NavigationManager

@inherits FluxorComponent

<div>
    <div>
        <MudText Typo="Typo.caption" Class="heading-meta">Email Verification</MudText>
        <MudText Typo="Typo.h4" GutterBottom="true" class="ttl-heading">Resend Verification</MudText>

        <div>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudCard Class="pb-3 div-login" style="height:100%">
                        <MudCardContent>
                            <div class="mb-3">
                                <MudText Typo="Typo.body2" Class="mb-2">
                                    Enter your email address and we'll resend your account verification email.
                                </MudText>
                            </div>

                            @if (!string.IsNullOrEmpty(successMessage))
                            {
                                <MudAlert Severity="Severity.Success" Class="mb-3">@successMessage</MudAlert>
                            }

                            @if (!string.IsNullOrEmpty(AuthState.Value.ErrorMessage))
                            {
                                <MudAlert Severity="Severity.Error" Class="mb-3">@AuthState.Value.ErrorMessage</MudAlert>
                            }

                            @if (string.IsNullOrEmpty(successMessage))
                            {
                                <EditForm Model="resendModel" OnValidSubmit="OnResendVerification">
                                    <DataAnnotationsValidator />

                                    <MudTextField T="string"
                                                  Label="Email Address *"
                                                  Placeholder="Enter your email address"
                                                  InputType="InputType.Email"
                                                  Class="mb-3"
                                                  Variant="Variant.Outlined"
                                                  FullWidth="true"
                                                  For="@(() => resendModel.EmailAddress)"
                                                  @bind-Value="resendModel.EmailAddress" />

                                    <MudButton ButtonType="ButtonType.Submit"
                                               Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               FullWidth="true"
                                               Class="login-btn"
                                               Disabled="@AuthState.Value.IsBusy">
                                        @if (AuthState.Value.IsBusy)
                                        {
                                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" />
                                            <span>Sending...</span>
                                        }
                                        else
                                        {
                                            <span>Resend Verification Email</span>
                                        }
                                    </MudButton>
                                </EditForm>
                            }

                            <div class="d-flex justify-content-center mt-3">
                                <MudLink Href="/authentication/login" Class="login-link">Back to Login</MudLink>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <div class="div-login-register-form">
                        <div class="div-login-register-form-contents">
                            <MudText Typo="Typo.h6" GutterBottom="true" class="ttl-sub-heading">Email Verification</MudText>
                            <MudText Typo="Typo.body1">Didn't receive your verification email?</MudText>
                            <MudList T="string" Dense="true" Class="verification-info">
                                <MudListItem T="string">Enter the email you registered with</MudListItem>
                                <MudListItem T="string">Check your inbox and spam folder</MudListItem>
                                <MudListItem T="string">Click the verification link in the email</MudListItem>
                                <MudListItem T="string">The link expires in 24 hours</MudListItem>
                            </MudList>
                        </div>
                    </div>
                </MudItem>
            </MudGrid>
        </div>
    </div>
</div>

<ProgressSpinner IsBusy="AuthState.Value.IsBusy" />

@code {
    private ResendVerificationModel resendModel = new();
    private string? successMessage;

    private void OnResendVerification()
    {
        successMessage = null;
        Dispatcher.Dispatch(new ResendVerificationAction(resendModel.EmailAddress));

        // Show success message regardless of outcome for security (avoid email enumeration)
        Task.Delay(500).ContinueWith(_ =>
        {
            successMessage = "If an account with that email exists and is unverified, you will receive a new verification email shortly.";
            InvokeAsync(StateHasChanged);
        });
    }

    public class ResendVerificationModel
    {
        [Required]
        [EmailAddress]
        public string EmailAddress { get; set; } = string.Empty;
    }
}
