DOCKERHUB_USER=your-dockerhub-user
IMAGE_TAG=latest
BUILD_CONFIGURATION=Release
ASPNETCORE_ENVIRONMENT=Production
APP_HTTP_PORT=8080
APP_HTTPS_PORT=8081

# Nested JSON binding: use double underscores for sections
# Example: Email__Smtp__Host maps to Email:Smtp:Host in appsettings

# General application settings
#AllowedHosts=*
#AuthorizationKey=your-authorization-key
#BaseApiServiceUrl=http://localhost:5000
BaseWebUrl=http://localhost:5001

# Secret keys
#SecretKeys__ApiKey=your-api-key
#SecretKeys__ApiKeySecondary=your-api-key-secondary
#SecretKeys__UseSecondaryKey=true

# Email settings
Email__FromEmail=dev@bluchilliworks.local
Email__FromName="BluChilli Works (Dev)"
Email__Smtp__Host=smtp.ethereal.email
Email__Smtp__Port=587
Email__Smtp__Security=STARTTLS
Email__Smtp__Username=hertha.luettgen92@ethereal.email
Email__Smtp__Password=your-smtp-password
Email__Smtp__EnableSsl=true

# Database settings
ConnectionStrings__DefaultConnection=Host=localhost;Database=bluchilliworks_dev;Username=postgres;Password=your-db-password

# Authentication session settings
#Authentication__Session__CookieName=__Host-MudBlazorWeb.Session
#Authentication__Session__IdleTimeoutMinutes=30
#Authentication__Session__AbsoluteLifetimeHours=8
#Authentication__Session__RevalidationIntervalSeconds=60
#Authentication__Session__ActivityRefreshThrottleSeconds=60
