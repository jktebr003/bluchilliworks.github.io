@using WebServer.Services
@implements IDisposable
@inject BusyDialogService BusyDialogService

@if (isVisible)
{
    <div class="busy-dialog-overlay">
        <div class="busy-dialog-container">
            <div class="busy-dialog-icon">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            </div>
            <div class="busy-dialog-content">
                <h2 class="busy-dialog-title">Please Wait</h2>
                <p class="busy-dialog-message">@currentMessage</p>
            </div>
        </div>
    </div>
}

<style>
    .busy-dialog-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        animation: fadeIn 0.3s ease;
    }

    .busy-dialog-container {
        background: white;
        border-radius: 12px;
        padding: 40px 50px;
        max-width: 400px;
        text-align: center;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
        animation: slideIn 0.3s ease;
    }

    .busy-dialog-icon {
        margin-bottom: 20px;
    }

    .busy-dialog-content {
        margin-top: 20px;
    }

    .busy-dialog-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: #333;
        margin: 0 0 10px 0;
    }

    .busy-dialog-message {
        font-size: 1rem;
        color: #666;
        margin: 0;
        line-height: 1.5;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @@keyframes slideIn {
        from {
            transform: translateY(-50px);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
</style>

@code {
    private bool isVisible;
    private string currentMessage = "Loading...";

    protected override void OnInitialized()
    {
        isVisible = BusyDialogService.IsBusy;
        currentMessage = BusyDialogService.Message;
        BusyDialogService.OnChange += OnBusyDialogStateChanged;
    }

    private async void OnBusyDialogStateChanged()
    {
        isVisible = BusyDialogService.IsBusy;
        currentMessage = BusyDialogService.Message;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        BusyDialogService.OnChange -= OnBusyDialogStateChanged;
    }
}
