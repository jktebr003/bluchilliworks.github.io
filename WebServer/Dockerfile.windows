ARG BASE_TAG=windowsservercore-ltsc2019
# Use the official .NET SDK image for build
FROM mcr.microsoft.com/dotnet/sdk:9.0-${BASE_TAG} AS build
WORKDIR /src

COPY ["BluChilliWorks.sln", "./"]
COPY ["WebServer/WebServer.csproj", "WebServer/"]
COPY ["Shared/Shared.csproj", "Shared/"]
COPY ["ServiceDefaults/ServiceDefaults.csproj", "ServiceDefaults/"]

RUN dotnet restore "WebServer/WebServer.csproj"

COPY WebServer/ WebServer/
COPY Shared/ Shared/
COPY ServiceDefaults/ ServiceDefaults/

WORKDIR /src/WebServer
RUN dotnet build "WebServer.csproj" -c Release -o /app/build
RUN dotnet publish "WebServer.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:9.0-${BASE_TAG} AS runtime
WORKDIR /app
COPY --from=build /app/publish .

EXPOSE 80
ENV ASPNETCORE_URLS=http://+:80
ENV ASPNETCORE_ENVIRONMENT=Production

ENTRYPOINT ["dotnet", "WebServer.dll"]
