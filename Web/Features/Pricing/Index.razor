@page "/pricing"

@using MudBlazor
@using global::Shared.Models
@using global::Shared.Enums
@using Fluxor
@using Fluxor.Blazor.Web.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Web.Features.Authentication
@using Web.Features.Users

@inject IState<PricingState> PricingState
@inject IState<UsersState> UsersState
@inject IDispatcher Dispatcher
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthenticationService AuthService

@inherits FluxorComponent

<div class="div-page-content">
    <span class="heading-meta">Pricing</span>
    <MudText Typo="Typo.h4" GutterBottom="true" class="ttl-heading">Our Packages</MudText>

    <div class="ttl-pricing">
        <!-- Package Type Filter -->
        <MudGrid Class="mb-4">
            <MudItem xs="12">
                <MudText Typo="Typo.body1" Class="mb-2">Package Type</MudText>
                <MudChipSet T="PackageType" 
                           SelectedValue="PricingState.Value.SelectedPackageType" 
                           SelectedValueChanged="@((PackageType value) => OnPackageTypeChanged(value))"
                           SelectionMode="SelectionMode.SingleSelection" 
                           CheckMark="true">
                    <MudChip T="PackageType" Value="@PackageType.None" Class="pricing-chip" Default="true">All Packages</MudChip>
                    <MudChip T="PackageType" Value="@PackageType.Monthly" Class="pricing-chip">Monthly</MudChip>
                    <MudChip T="PackageType" Value="@PackageType.TwoYearSubscription" Class="pricing-chip">2-year Subscription</MudChip>
                </MudChipSet>
            </MudItem>
        </MudGrid>

        <!-- Loading State -->
        @if (PricingState.Value.IsLoading)
        {
            <div class="text-center py-5">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                <MudText Typo="Typo.body1" Class="mt-3">Loading packages...</MudText>
            </div>
        }
        else if (PricingState.Value.ErrorMessage != null)
        {
            <MudAlert Severity="MudBlazor.Severity.Error" Class="mb-4">
                @PricingState.Value.ErrorMessage
            </MudAlert>
        }
        else if (PricingState.Value.FilteredPackages == null || !PricingState.Value.FilteredPackages.Any())
        {
            <MudAlert Severity="MudBlazor.Severity.Info">
                No packages available for the selected type.
            </MudAlert>
        }
        else
        {
            <!-- Package Grid -->
            <MudGrid>
                @foreach (var package in PricingState.Value.FilteredPackages)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Class="pricing-card" Elevation="3">
                            <MudCardContent>
                                <MudText Typo="Typo.h5" Class="mb-2">@package.Name</MudText>
                                <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-3">
                                    @package.Price
                                </MudText>
                                <MudDivider Class="mb-3" />
                                <MudText Typo="Typo.body2" Class="mb-3">
                                    @package.Description
                                </MudText>
                                <MudChip T="string" Color="Color.Secondary" Size="Size.Small">
                                    @GetPackageTypeDisplayName(package.Type)
                                </MudChip>
                            </MudCardContent>
                            <MudCardActions>
                                @if (isAuthenticated && UsersState.Value.CurrentUser?.Package == null)
                                {
                                    <MudButton Variant="Variant.Filled" 
                                              Color="Color.Primary" 
                                              FullWidth="true"
                                              OnClick="@(() => SelectPackage(package))">
                                        Select Package
                                    </MudButton>
                                }
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    </div>
</div>

@code {
    private bool isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await CheckAuthenticationStatus();
        Dispatcher.Dispatch(new LoadPackagesAction());
        
        // Load current user profile if authenticated
        if (isAuthenticated)
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user?.ID != null)
            {
                Dispatcher.Dispatch(new LoadUserProfileAction(user.ID));
            }
        }
    }

    private async Task CheckAuthenticationStatus()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
        StateHasChanged();
    }

    private void OnPackageTypeChanged(PackageType value)
    {
        Dispatcher.Dispatch(new FilterPackagesByTypeAction(value));
    }

    private async Task SelectPackage(PackageResponse package)
    {
        var currentUser = UsersState.Value.CurrentUser;
        
        if (currentUser == null)
        {
            Snackbar.Add("User not found. Please log in again.", MudBlazor.Severity.Error);
            return;
        }

        try
        {
            // Dispatch action to select package in state
            Dispatcher.Dispatch(new SelectPackageAction(package));

            // Update user profile with selected package
            var updateRequest = new UpdateUserRequest
            {
                Id = currentUser.ID ?? string.Empty,
                Name = currentUser.Name,
                FirstName = currentUser.FirstName,
                LastName = currentUser.LastName,
                Username = currentUser.Username,
                EmailAddress = currentUser.EmailAddress,
                TelephoneNumber = currentUser.TelephoneNumber,
                MobileNumber = currentUser.MobileNumber,
                Gender = currentUser.Gender,
                DateOfBirth = currentUser.DateOfBirth,
                PackageId = package.ID,
                Jobs = currentUser.Jobs,
                Qualifications = currentUser.Qualifications,
                UserType = currentUser.UserRole,
                @* EncryptedPassword = currentUser.EncryptedPassword,
                DecryptedPassword = currentUser.DecryptedPassword, *@
                ModifiedOn = DateTime.UtcNow,
                ModifiedBy = currentUser.Username ?? "system"
            };

            // Dispatch update user profile action - this will handle DB update and local storage
            Dispatcher.Dispatch(new UpdateUserProfileAction(updateRequest));
            
            Snackbar.Add($"Successfully selected: {package.Name}", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error selecting package: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private string GetPackageTypeDisplayName(PackageType type)
    {
        return type switch
        {
            PackageType.Monthly => "Monthly",
            PackageType.TwoYearSubscription => "2-year Subscription",
            _ => "Standard"
        };
    }
}
