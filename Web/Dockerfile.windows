

# escape=`
ARG BASE_TAG=windowsservercore-ltsc2019

# Build stage
FROM mcr.microsoft.com/dotnet/sdk:9.0-${BASE_TAG} AS build
WORKDIR /src

# Copy everything for a complete publish
COPY . .

# Publish Blazor WASM app (includes web.config and all static files)
RUN dotnet publish "Web/Web.csproj" -c Release -o C:/app/publish

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:9.0-${BASE_TAG}
WORKDIR /inetpub/wwwroot

# Copy all published files (including web.config) to IIS root
COPY --from=build C:/app/publish/ .

# Expose port 80 for IIS
EXPOSE 80

# IIS will start automatically; no need to set ENTRYPOINT or CMD
