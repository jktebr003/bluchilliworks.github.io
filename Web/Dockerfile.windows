# escape=`

# Build stage
FROM mcr.microsoft.com/dotnet/sdk:9.0-windowsservercore-ltsc2022 AS build
WORKDIR /src

# Copy solution and project files
COPY ["BluChilliWorks.sln", "./"]
COPY ["Web/Web.csproj", "Web/"]
COPY ["Shared/Shared.csproj", "Shared/"]

# Restore dependencies
RUN dotnet restore "Web/Web.csproj"

# Copy remaining source code
COPY Web/ Web/
COPY Shared/ Shared/

# Build and publish (Blazor WebAssembly publishes to wwwroot)
WORKDIR /src/Web
RUN dotnet publish "Web.csproj" -c Release -o C:/app/publish

# Runtime stage - use IIS to serve static files
FROM mcr.microsoft.com/dotnet/aspnet:9.0-windowsservercore-ltsc2022 AS runtime
WORKDIR /inetpub/wwwroot

# Copy published Blazor WebAssembly files
COPY --from=build C:/app/publish/wwwroot/ .

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD powershell -command "try { $response = Invoke-WebRequest http://localhost/; if ($response.StatusCode -eq 200) { exit 0 } else { exit 1 } } catch { exit 1 }"
