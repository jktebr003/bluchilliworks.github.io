@page "/busydialog-demo"
@using Web.Services
@inject BusyDialogService BusyDialogService

<PageTitle>BusyDialog Demo</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudText Typo="Typo.h3" GutterBottom="true">BusyDialog Component Demo</MudText>
    <MudText Typo="Typo.body1" Class="mb-6">
        This page demonstrates the BusyDialog component that shows a loading spinner with a customizable message.
    </MudText>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" GutterBottom="true">Basic Usage</MudText>
        
        <MudStack Spacing="3">
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       OnClick="ShowDefaultBusyDialog">
                Show Default Message (3 seconds)
            </MudButton>

            <MudButton Variant="Variant.Filled" 
                       Color="Color.Secondary" 
                       OnClick="ShowCustomMessageDialog">
                Show Custom Message (3 seconds)
            </MudButton>

            <MudButton Variant="Variant.Filled" 
                       Color="Color.Tertiary" 
                       OnClick="ShowMultiStepDialog">
                Show Multi-Step Process (9 seconds)
            </MudButton>

            <MudButton Variant="Variant.Filled" 
                       Color="Color.Info" 
                       OnClick="ShowLongOperation">
                Simulate API Call (5 seconds)
            </MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h6" GutterBottom="true">Code Example</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">Inject the service:</MudText>
        <MudPaper Class="pa-2 mb-3" Elevation="0" Style="background-color: #f5f5f5;">
            <code>@@inject BusyDialogService BusyDialogService</code>
        </MudPaper>

        <MudText Typo="Typo.body2" Class="mb-2">Use in your code:</MudText>
        <MudPaper Class="pa-2" Elevation="0" Style="background-color: #f5f5f5;">
            <code>
                <pre style="margin: 0;">
BusyDialogService.Show("Processing...");
try 
{
    await YourAsyncOperation();
}
finally 
{
    BusyDialogService.Hide();
}</pre>
            </code>
        </MudPaper>
    </MudPaper>
</MudContainer>

@code {
    private async Task ShowDefaultBusyDialog()
    {
        BusyDialogService.Show();
        await Task.Delay(3000);
        BusyDialogService.Hide();
    }

    private async Task ShowCustomMessageDialog()
    {
        BusyDialogService.Show("Processing your custom request...");
        await Task.Delay(3000);
        BusyDialogService.Hide();
    }

    private async Task ShowMultiStepDialog()
    {
        BusyDialogService.Show("Step 1: Loading data...");
        await Task.Delay(3000);
        
        BusyDialogService.Show("Step 2: Processing...");
        await Task.Delay(3000);
        
        BusyDialogService.Show("Step 3: Finalizing...");
        await Task.Delay(3000);
        
        BusyDialogService.Hide();
    }

    private async Task ShowLongOperation()
    {
        BusyDialogService.Show("Calling API...");
        
        try
        {
            // Simulate an API call
            await Task.Delay(5000);
            // Success!
        }
        catch (Exception ex)
        {
            // Handle error
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            // Always hide the dialog
            BusyDialogService.Hide();
        }
    }
}
